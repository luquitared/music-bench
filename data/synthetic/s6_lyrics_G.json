 "lyrics": [
  {
   "start": 2.0,
   "text": "Walking down the copper river in the rain",
   "end": 4.24
  },
  {
   "start": 12.0,
   "text": "Every window holds a candle and a name",
   "end": 14.33
  },
  {
   "start": 22.0,
   "text": "I will carry what you gave me through the night",
   "end": 24.27
  },
  {
   "start": 32.0,
   "text": "Till the morning paints the harbor gold and white",
   "end": 34.54
  }
 ]
