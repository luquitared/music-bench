 "lyrics": [
  {
   "start": 14.23,
   "end": 16.01,
   "text": "Tears are like"
  },
  {
   "start": 16.01,
   "end": 18.25,
   "text": "Diamonds in my eyes"
  },
  {
   "start": 18.3,
   "end": 19.63,
   "text": "Blind me so"
  },
  {
   "start": 19.63,
   "end": 22.03,
   "text": "Now you're out of sight"
  },
  {
   "start": 21.84,
   "end": 23.16,
   "text": "It's enough"
  },
  {
   "start": 23.22,
   "end": 27.64,
   "text": "It's too late to break the silence"
  },
  {
   "start": 28.43,
   "end": 29.8,
   "text": "In a rose"
  },
  {
   "start": 29.8,
   "end": 32.02,
   "text": "Colored view of us"
  },
  {
   "start": 32.02,
   "end": 33.42,
   "text": "I got lost"
  },
  {
   "start": 33.42,
   "end": 35.87,
   "text": "Could I realize"
  },
  {
   "start": 35.99,
   "end": 37.39,
   "text": "All your lies"
  },
  {
   "start": 37.39,
   "end": 39.21,
   "text": "Would be blades and knives"
  },
  {
   "start": 39.67,
   "end": 41.33,
   "text": "To stab me inside"
  },
  {
   "start": 41.15,
   "end": 44.69,
   "text": "Who will save you from this dark?"
  },
  {
   "start": 44.69,
   "end": 48.24,
   "text": "Who will fix your selfish heart?"
  },
  {
   "start": 48.0,
   "end": 49.68,
   "text": "A one-way street"
  },
  {
   "start": 49.72,
   "end": 51.4,
   "text": "That's how you live"
  },
  {
   "start": 51.53,
   "end": 54.68,
   "text": "Why do you always take and never give?"
  },
  {
   "start": 83.25,
   "end": 84.53,
   "text": "Wide awake"
  },
  {
   "start": 84.53,
   "end": 86.88,
   "text": "Yeah, I've crossed the line"
  },
  {
   "start": 86.78,
   "end": 88.24,
   "text": "I'm coming home"
  },
  {
   "start": 88.24,
   "end": 90.71,
   "text": "I'm running back to real life"
  },
  {
   "start": 90.87,
   "end": 92.22,
   "text": "To the start"
  },
  {
   "start": 92.22,
   "end": 95.88,
   "text": "Where I could breathe in freely, baby"
  },
  {
   "start": 96.65,
   "end": 98.76,
   "text": "Can't you see we run out of time?"
  },
  {
   "start": 98.76,
   "end": 101.41,
   "text": "Chasing happiness while you"
  },
  {
   "start": 101.41,
   "end": 103.05,
   "text": "Get what you need"
  },
  {
   "start": 103.52,
   "end": 105.7,
   "text": "There's nothing left of us"
  },
  {
   "start": 105.7,
   "end": 107.77,
   "text": "But bleeding blades and knives"
  },
  {
   "start": 107.77,
   "end": 109.1,
   "text": "Tonight"
  },
  {
   "start": 109.1,
   "end": 110.35,
   "text": "You'll know how it"
  },
  {
   "start": 110.35,
   "end": 111.79,
   "text": "Feels"
  },
  {
   "start": 111.58,
   "end": 113.23,
   "text": "A one-way street"
  },
  {
   "start": 113.23,
   "end": 115.05,
   "text": "That's how you live"
  },
  {
   "start": 115.05,
   "end": 118.4,
   "text": "Why do you always take and never give?"
  },
  {
   "start": 118.71,
   "end": 120.28,
   "text": "I'll walk away"
  },
  {
   "start": 120.28,
   "end": 122.12,
   "text": "To help you see"
  },
  {
   "start": 122.25,
   "end": 125.92,
   "text": "Our loving is rolling down so easily"
  },
  {
   "start": 125.66,
   "end": 128.05,
   "text": "A one-way street"
  },
  {
   "start": 153.68,
   "end": 157.88,
   "text": "A one-way street"
  },
  {
   "start": 158.96,
   "end": 161.36,
   "text": "You never give"
  },
  {
   "start": 162.45,
   "end": 165.14,
   "text": "I'll walk away"
  },
  {
   "start": 166.04,
   "end": 169.16,
   "text": "So easily"
  }
 ],
