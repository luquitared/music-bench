 ],
 "lyrics": [
  {
   "start": 12.38,
   "end": 18.99,
   "text": "Ich geb ein Tigerfest zu Haus in meinem Garten,"
  },
  {
   "start": 18.99,
   "end": 25.37,
   "text": "ich lad euch alle dazu herzlichst ein."
  },
  {
   "start": 25.37,
   "end": 30.98,
   "text": "Die Frauen solln noch warten, die M\u00e4nner solln kommen."
  },
  {
   "start": 30.98,
   "end": 36.8,
   "text": "Nicht gleich die Verliebten, erst nehm ich die Frommen."
  },
  {
   "start": 36.8,
   "end": 43.31,
   "text": "Da gibt es Zuckerbrot und Wein und ganz spezielle Leckereien."
  },
  {
   "start": 43.31,
   "end": 49.3,
   "text": "Ihr werdet alle sehr zufrieden sein."
  },
  {
   "start": 49.3,
   "end": 55.02,
   "text": "Und bei dem Tigerfest zu Haus in meinem Garten,"
  },
  {
   "start": 55.02,
   "end": 61.56,
   "text": "da gibt's Musik und Tanz und Liebelei."
  },
  {
   "start": 61.56,
   "end": 67.35,
   "text": "Es muss nicht entarten, wir sind nicht in Eile."
  },
  {
   "start": 67.35,
   "end": 73.11,
   "text": "Ich kriege schon Schwung rein, wenn ich euch verteile."
  },
  {
   "start": 73.11,
   "end": 79.7,
   "text": "Es kommt ein Jeder an die Reih' mit Allerliebst und Allerlei,"
  },
  {
   "start": 79.7,
   "end": 85.15,
   "text": "ihr f\u00fchlt euch sicher alle wohl dabei."
  },
  {
   "start": 85.15,
   "end": 91.11,
   "text": "Dann kommen die Tiger aus ihrem Versteck,"
  },
  {
   "start": 91.11,
   "end": 97.43,
   "text": "da werdet ihr schreien, ein paar laufen weg."
  },
  {
   "start": 97.43,
   "end": 103.85,
   "text": "Doch lie\u00df ich schon lange die Tore versperren,"
  },
  {
   "start": 103.85,
   "end": 110.97,
   "text": "denn die Tiger haben Hunger und sie fressen gern."
  },
  {
   "start": 110.97,
   "end": 116.58,
   "text": "Sie werden euch verspeisen, zuerst alle Frauen,"
  },
  {
   "start": 116.58,
   "end": 122.92,
   "text": "danach alle Weisen und alle Schlauen,"
  },
  {
   "start": 122.92,
   "end": 129.3,
   "text": "als Letztes die Dummen, ja, da hilft keine List,"
  },
  {
   "start": 129.3,
   "end": 136.3,
   "text": "so lang bis keiner von euch \u00fcbrig ist."
  },
  {
   "start": 136.3,
   "end": 141.87,
   "text": "Ein paar Stunden sp\u00e4ter, da sitz ich allein"
  },
  {
   "start": 141.87,
   "end": 148.27,
   "text": "auf meiner Terrasse und trinke den Wein"
  },
  {
   "start": 148.27,
   "end": 154.64,
   "text": "und esse die Reste und rekle mich m\u00fcd"
  },
  {
   "start": 154.64,
   "end": 161.36,
   "text": "und sing mir selber noch das kleine Lied."
  },
  {
   "start": 161.36,
   "end": 167.2,
   "text": "Ich gab ein Tigerfest zu Haus in meinem Garten,"
  },
  {
   "start": 167.2,
   "end": 173.79,
   "text": "ein recht geselliges Beisammensein."
  },
  {
   "start": 173.79,
   "end": 179.55,
   "text": "Erst lie\u00df ich es starten, dann kamen die Tiger."
  },
  {
   "start": 179.55,
   "end": 185.33,
   "text": "Die Menschen waren wehrlos, die Tiger blieben Sieger."
  },
  {
   "start": 185.33,
   "end": 193.49,
   "text": "Ja, solche Feste find ich fein und sie gelingen allgemein."
  },
  {
   "start": 193.49,
   "end": 201.3,
   "text": "Ich lad euch alle, alle herzlichst ein."
  }
 ],
