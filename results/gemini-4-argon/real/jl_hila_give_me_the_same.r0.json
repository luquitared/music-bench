  {
   "start": 146.94,
   "end": 151.14,
   "text": "How you let me down"
  },
  {
   "start": 151.14,
   "end": 154.5,
   "text": "But somehow"
  },
  {
   "start": 154.5,
   "end": 161.26,
   "text": "Deep down I still do love you"
  },
  {
   "start": 161.26,
   "end": 169.39,
   "text": "How could you just throw it all away"
  },
  {
   "start": 169.39,
   "end": 176.29,
   "text": "I stayed with you through all the lies and pain"
  },
  {
   "start": 178.12,
