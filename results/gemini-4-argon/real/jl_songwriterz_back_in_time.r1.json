  {
   "end": 13.7,
   "start": 10.74,
   "text": "Honey I told you something"
  },
  {
   "end": 15.9,
   "start": 13.7,
   "text": "Sorry I didn't hear"
  },
  {
   "end": 18.6,
   "start": 16.58,
   "text": "Maybe there was something"
  },
  {
   "end": 19.62,
   "start": 18.6,
   "text": "Yeah, yeah, yeah"
  },
  {
   "end": 21.12,
   "start": 19.62,
   "text": "Stuck in your ear"
  },
  {
   "end": 26.8,
   "start": 22.63,
   "text": "Why is it every time you say you do you don't?"
  },
  {
   "end": 32.5,
