 "lyrics": [
  {
   "start": 13.79,
   "end": 16.58,
   "text": "Einsamkeit, was du gemacht."
  },
  {
   "start": 17.51,
   "end": 20.53,
   "text": "Ich hab geweint, du hast gelacht."
  },
  {
   "start": 21.02,
   "end": 23.62,
   "text": "Ich frag, warum willst du mich nicht?"
  },
  {
   "start": 24.43,
   "end": 27.66,
   "text": "Schau mir doch wieder ins Gesicht."
  },
  {
   "start": 28.05,
   "end": 30.88,
   "text": "Ich hab gewacht die ganze Nacht."
  },
  {
   "start": 31.65,
   "end": 34.48,
   "text": "Ich hab kein Auge zugemacht."
  },
  {
   "start": 35.11,
   "end": 37.94,
   "text": "Ich wasch mich nicht, von Gram erf\u00fcllt"
  },
  {
   "start": 38.76,
   "end": 43.8,
   "text": "seh ich im Glas mein Ebenbild."
  },
  {
   "start": 44.31,
   "end": 49.42,
   "text": "Und sehe, ich hab Akne, ich hab Akne, ich hab Akne."
  },
  {
   "start": 49.65,
   "end": 56.61,
   "text": "Meine Poren sind verschmutzt und ganz verstopft."
  },
  {
   "start": 56.85,
   "end": 60.03,
   "text": "Meine Haut neigt zu Unreinheit."
  },
  {
   "start": 60.28,
   "end": 63.48,
   "text": "Oh, mein Gott, wie seh ich aus."
  },
  {
   "start": 63.65,
   "end": 66.85,
   "text": "Heimlich steh ich vorm Spiegel,"
  },
  {
   "start": 67.02,
   "end": 71.15,
   "text": "dr\u00fcck mir einen Pickel aus."
  },
  {
   "start": 82.06,
   "end": 85.45,
   "text": "Doch dann eines Tages, da kam sie."
  },
  {
   "start": 85.75,
   "end": 89.26,
   "text": "Sie sagte, Akne, c'est la vie."
  },
  {
   "start": 89.52,
   "end": 92.21,
   "text": "Sie hat mit Pickeln kein Problem."
  },
  {
   "start": 93.04,
   "end": 96.34,
   "text": "Nicht mit Furunkeln und nicht mit Ekzem."
  },
  {
   "start": 96.69,
   "end": 99.64,
   "text": "F\u00fcr sie z\u00e4hlt nicht die eigne H\u00e4rte."
  },
  {
   "start": 100.2,
   "end": 103.52,
   "text": "F\u00fcr sie z\u00e4hln nur die inneren Werte."
  },
  {
   "start": 103.7,
   "end": 106.95,
   "text": "Sie sagt, sei mutig, steh dazu,"
  },
  {
   "start": 107.14,
   "end": 113.06,
   "text": "dr\u00fcck sie aus, dann hast du Ruh."
  },
  {
   "start": 113.41,
   "end": 118.43,
   "text": "Und darum, ich hab Akne, ich hab Akne, ich hab Akne."
  },
  {
   "start": 118.7,
   "end": 125.9,
   "text": "Meine Poren sind verschmutzt und ganz verstopft."
  },
  {
   "start": 126.07,
   "end": 129.04,
   "text": "Meine Haut neigt zu Unreinheit."
  },
  {
   "start": 129.27,
   "end": 132.94,
   "text": "Oh mon Dieu, wie seh ich aus."
  },
  {
   "start": 133.24,
   "end": 136.4,
   "text": "Heimlich steh ich vorm Spiegel,"
  },
  {
   "start": 136.68,
   "end": 140.46,
   "text": "dr\u00fcck mir einen Pickel aus."
  },
  {
   "start": 146.5,
   "end": 150.35,
   "text": "Ihr habt Akne, ihr habt Akne, ihr habt Akne."
  },
  {
   "start": 150.61,
   "end": 157.09,
   "text": "Und dazu ein kleines bisschen Mundgeruch."
  },
  {
   "start": 157.44,
   "end": 160.37,
   "text": "Ja, Ger\u00fcche und Ged\u00fcfte,"
  },
  {
   "start": 160.54,
   "end": 164.07,
   "text": "die geh\u00f6rn zu einem Mann."
  },
  {
   "start": 164.26,
   "end": 167.28,
   "text": "Darum lass ich, wenn ich bei dir"
  },
  {
   "start": 167.54,
   "end": 170.76,
   "text": "liege, meine"
  },
  {
   "start": 173.49,
   "end": 183.71,
   "text": "Stiefel an."
  }
 ],
