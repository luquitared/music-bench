  },
  {
   "end": 48.39,
   "start": 45.4,
   "text": "Whisper words of wisdom,"
  },
  {
   "end": 49.9,
   "start": 48.39,
   "text": "let it be"
  },
  {
   "end": 55.031,
   "start": 51.6,
   "text": "And when the broken hearted people"
  },
  {
   "end": 57.8,
   "start": 55.031,
   "text": "living in the world agree"
  },
  {
   "end": 61.1,
   "start": 57.8,
   "text": "There will be an answer,"
  },
  {
   "end": 62.8,
   "start": 61.1,
   "text": "let it be"
  },
  {
   "end": 68.22,
   "start": 64.7,
   "text": "For though they may be parted,"
  },
  {
   "end": 71.2,
   "start": 68.22,
   "text": "there is still a chance that they will see"
  },
  {
   "end": 74.5,
   "start": 71.2,
   "text": "There will be an answer,"
  },
  {
   "end": 76.533,
   "start": 74.5,
