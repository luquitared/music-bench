 "lyrics": [
  {
   "end": 16.951,
   "start": 12.8,
   "text": "When I find myself in times of trouble,"
  },
  {
   "end": 19.3,
   "start": 16.951,
   "text": "Mother Mary comes to me"
  },
  {
   "end": 21.966,
   "start": 19.3,
   "text": "Speaking words of wisdom,"
  },
  {
   "end": 23.592,
   "start": 21.966,
   "text": "let it be"
  },
  {
   "end": 29.3,
   "start": 25.6,
   "text": "And in my hour of darkness"
  },
  {
   "end": 32.8,
   "start": 29.3,
   "text": "she is standing right in front of me"
  },
  {
   "end": 35.155,
   "start": 32.8,
   "text": "Speaking words of wisdom,"
  },
  {
   "end": 36.827,
   "start": 35.155,
   "text": "let it be"
  },
  {
   "end": 39.9,
   "start": 38.0,
   "text": "Let it be,"
  },
  {
   "end": 41.3,
   "start": 39.9,
