  },
  {
   "end": 48.62,
   "start": 45.55,
   "text": "Lil motherfuckers never ever gonna shine off me"
  },
  {
   "end": 51.1,
   "start": 48.62,
   "text": "Wait for it, wait for it, wait for it"
  },
  {
   "end": 53.68,
   "start": 51.1,
   "text": "Don't worry my haters is gonna pay for it."
  },
  {
   "end": 55.98,
   "start": 53.68,
   "text": "Chase dreams while dumb niggas'll chase whores"
  },
  {
   "end": 58,
