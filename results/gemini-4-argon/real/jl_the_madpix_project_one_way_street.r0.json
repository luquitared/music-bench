 "lyrics": [
  {
   "end": 17.77,
   "start": 13.89,
   "text": "Tears are like diamonds in my eyes"
  },
  {
   "end": 21.11,
   "start": 17.77,
   "text": "Look me so now you're out of sight"
  },
  {
   "end": 22.77,
   "start": 21.11,
   "text": "It's enough"
  },
  {
   "end": 27.22,
   "start": 22.77,
   "text": "It's too late to break this silence"
  },
  {
   "end": 31.67,
   "start": 27.78,
   "text": "In a rose colored view of us"
  },
  {
   "end": 33.33,
   "start": 31.67,
   "text": "I got lost"
  },
  {
   "end": 35.55,
   "start": 33.33,
   "text": "Could I realize"
  },
  {
   "end": 38.89,
   "start": 35.55,
   "text": "all your lies would be blades and knives"
  },
  {
   "end": 41.11,
   "start": 38.89,
   "text": "To stab me inside"
  },
  {
   "end": 43.89,
   "start": 41.11,
   "text": "Who will save you from this dark?"
  },
  {
   "end": 47.78,
   "start": 44.44,
   "text": "Who will fix your selfish heart?"
  },
  {
   "end": 50.0,
   "start": 47.78,
   "text": "A one way street"
  },
  {
   "end": 51.11,
   "start": 50.0,
   "text": "That's how you live"
  },
  {
   "end": 55.0,
   "start": 51.11,
   "text": "Why do you always take and never give?"
  },
  {
   "end": 85.0,
   "start": 83.34,
   "text": "Wide awake"
  },
  {
   "end": 87.23,
   "start": 85.0,
   "text": "Yeah, I've crossed the line"
  },
  {
   "end": 88.34,
   "start": 87.23,
   "text": "I'm coming home"
  },
  {
   "end": 90.56,
   "start": 88.34,
   "text": "I'm running back to real life"
  },
  {
   "end": 92.23,
   "start": 90.56,
   "text": "To the start"
  },
  {
   "end": 95.56,
   "start": 92.23,
   "text": "Where I could breathe in freely, baby"
  },
  {
   "end": 97.23,
   "start": 96.12,
   "text": "Can't you see"
  },
  {
   "end": 100.56,
   "start": 97.23,
   "text": "we're running out of time chasing happiness"
  },
  {
   "end": 102.78,
   "start": 100.56,
   "text": "while you get what you need"
  },
  {
   "end": 105.0,
   "start": 102.78,
   "text": "There's nothing left of us"
  },
  {
   "end": 106.67,
   "start": 105.0,
   "text": "but bleeding blades and knives"
  },
  {
   "end": 107.78,
   "start": 106.67,
   "text": "Tonight"
  },
  {
   "end": 109.45,
   "start": 107.78,
   "text": "you'll know how it feels"
  },
  {
   "end": 111.67,
   "start": 109.45,
   "text": "A one way street"
  },
  {
   "end": 112.78,
   "start": 111.67,
   "text": "That's how you live"
  },
  {
   "end": 116.67,
   "start": 112.78,
   "text": "Why do you always take and never give?"
  },
  {
   "end": 119.45,
   "start": 116.67,
   "text": "I'll walk away to help you see"
  },
  {
   "end": 123.9,
   "start": 119.45,
   "text": "Our love is rolling down so easily"
  },
  {
   "end": 126.12,
   "start": 123.9,
   "text": "A one way street"
  },
  {
   "end": 157.79,
   "start": 155.57,
   "text": "A one way street"
  },
  {
   "end": 159.45,
   "start": 157.79,
   "text": "(a one way street)"
  },
  {
   "end": 161.12,
   "start": 159.45,
   "text": "You never give"
  },
  {
   "end": 162.79,
   "start": 161.12,
   "text": "(a one way street)"
  },
  {
   "end": 164.45,
   "start": 162.79,
   "text": "I'll walk away"
  },
  {
   "end": 166.12,
   "start": 164.45,
