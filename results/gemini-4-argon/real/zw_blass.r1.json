 "lyrics": [
  {
   "start": 40.479,
   "end": 44.519,
   "text": "Ich bin etwas blass,"
  },
  {
   "start": 45.559,
   "end": 48.799,
   "text": "findest du nicht?"
  },
  {
   "start": 50.439,
   "end": 56.839,
   "text": "Der Fr\u00fchling ist noch immer nicht in Sicht."
  },
  {
   "start": 58.44,
   "end": 61.599,
   "text": "Ein bisschen blass,"
  },
  {
   "start": 62.88,
   "end": 66.0,
   "text": "und die Haut auch rau"
  },
  {
   "start": 66.599,
   "end": 72.36,
   "text": "und kein Lied auf den Lippen, schau."
  },
  {
   "start": 73.92,
   "end": 80.599,
   "text": "Ich hab Gefallen am Herbst gefunden"
  },
  {
   "start": 81.199,
   "end": 86.68,
   "text": "und auch an den Winter gew\u00f6hnt man sich."
  },
  {
   "start": 87.48,
   "end": 95.36,
   "text": "Ich bin ja nicht alt und krank und geschunden,"
  },
  {
   "start": 97.12,
   "end": 100.36,
   "text": "aber etwas blass,"
  },
  {
   "start": 101.08,
   "end": 104.76,
   "text": "findest du nicht?"
  },
  {
   "start": 105.72,
   "end": 107.599,
   "text": "Drei, vier."
  },
  {
   "start": 140.919,
   "end": 147.24,
   "text": "Ich hab Gefallen am Herbst gefunden"
  },
  {
   "start": 147.84,
