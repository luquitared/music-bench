 "lyrics": [
  {
   "end": 44.91,
   "start": 40.82,
   "text": "Got a lot on my mind and all of the time I'm trying to do right"
  },
  {
   "end": 50.8,
   "start": 45.88,
   "text": "I may have lost a lot, but I'm keeping it tight, never give up the fight, no"
  },
  {
   "end": 53.02,
   "start": 50.8,
   "text": "When my life is a wreck"
  },
  {
   "end": 58.48,
   "start": 55.44,
   "text": "Got to keep it all in check"
  },
  {
   "end": 114.66,
   "start": 110.29,
   "text": "Even in the darkest days, got a trail to blaze, gonna stick to my ways"
  },
  {
   "end": 119.57,
   "start": 115.23,
   "text": "I used to be caught in a phase where life was a maze until I saw the sun's rays"
  },
  {
   "end": 122.6,
   "start": 119.86,
   "text": "When your life is a wreck"
  },
  {
   "end": 130.61,
   "start": 125.12,
   "text": "You got to take the first step, yeah"
  },
  {
   "end": 132.45,
   "start": 129.99,
   "text": "Woah-oh-oh-oh-oh"
  },
  {
   "end": 135.3,
   "start": 132.45,
   "text": "Ride along through the waves now"
  },
  {
   "end": 137.4,
   "start": 134.98,
   "text": "Woah-oh-oh-oh-oh"
  },
  {
   "end": 139.92,
   "start": 137.4,
   "text": "Gonna take me to that place"
  },
  {
   "end": 142.3,
   "start": 139.92,
   "text": "Woah-oh-oh-oh-oh"
  },
  {
   "end": 144.83,
   "start": 142.3,
   "text": "Find the fire inside"
  },
  {
