 "lyrics": [
  {
   "start": 12.8,
   "end": 18.18,
   "text": "Ich geb ein Tigerfest zu Haus in meinem Garten."
  },
  {
   "start": 18.88,
   "end": 23.43,
   "text": "Ich lad euch alle dazu herzlichst ein."
  },
  {
   "start": 25.3,
   "end": 27.79,
   "text": "Die Frauen solln noch warten,"
  },
  {
   "start": 28.56,
   "end": 30.92,
   "text": "die M\u00e4nner solln kommen."
  },
  {
   "start": 31.59,
   "end": 34.33,
   "text": "Nicht gleich die Verliebten."
  },
  {
   "start": 34.81,
   "end": 36.99,
   "text": "Erst nehm ich die Frommen."
  },
  {
   "start": 37.65,
   "end": 43.13,
   "text": "Da gibt es Zuckerbrot und Wein und ganz spezielle Leckereien."
  },
  {
   "start": 43.5,
   "end": 47.99,
   "text": "Ihr werdet alle sehr zufrieden sein."
  },
  {
   "start": 49.68,
   "end": 54.51,
   "text": "Und bei dem Tigerfest zu Haus in meinem Garten,"
  },
  {
   "start": 55.28,
   "end": 59.22,
   "text": "da gibts Musik und Tanz und Liebelein."
  },
  {
   "start": 61,
   "end": 63.26,
   "text": "Es muss nicht entarten."
  },
  {
   "start": 64.18,
   "end": 66.52,
   "text": "Wir sind nicht in Eile."
  },
  {
   "start": 67.39,
   "end": 69.51,
   "text": "Ich kriege schon Schwung rein,"
  },
  {
   "start": 70.07,
   "end": 72.42,
   "text": "wenn ich euch verteile."
  },
  {
   "start": 73.21,
   "end": 78.51,
   "text": "Es kommt ein jeder an die Reih mit Allerliebst und Scharlerlei."
  },
  {
   "start": 78.99,
   "end": 83.74,
   "text": "Ihr f\u00fchlt euch sicher alle wohl dabei."
  },
  {
   "start": 85.79,
   "end": 88.53,
   "text": "Dann kommen die Tiger"
  },
  {
   "start": 88.91,
   "end": 91.43,
   "text": "aus ihrem Versteck."
  },
  {
   "start": 92.17,
   "end": 94.66,
   "text": "Da werdet ihr schreien."
  },
  {
   "start": 95.1,
   "end": 97.02,
   "text": "Ein paar laufen weg."
  },
  {
   "start": 97.35,
   "end": 100.38,
   "text": "Doch lie\u00df ich schon lange"
  },
  {
   "start": 100.81,
   "end": 103.32,
   "text": "die Tore versperren."
  },
  {
   "start": 103.65,
   "end": 108.53,
   "text": "Denn die Tiger haben Hunger und sie fressen gern."
  },
  {
   "start": 109.78,
   "end": 112.92,
   "text": "Sie werden euch verspeisen,"
  },
  {
   "start": 113.38,
   "end": 115.7,
   "text": "zuerst alle Frauen."
  },
  {
   "start": 116.17,
   "end": 119.3,
   "text": "Danach alle Weisen"
  },
  {
   "start": 119.52,
   "end": 121.24,
   "text": "und alle Schlauen."
  },
  {
   "start": 121.84,
   "end": 124.48,
   "text": "Als letztes die Dummen."
  },
  {
   "start": 125.02,
   "end": 127.09,
   "text": "Ja, da hilft keine List,"
  },
  {
   "start": 127.64,
   "end": 133.54,
   "text": "so lang bis keiner von euch \u00fcbrig ist."
  },
  {
   "start": 134.93,
   "end": 137.41,
   "text": "Ein paar Stunden sp\u00e4ter,"
  },
  {
   "start": 138.31,
   "end": 140.42,
   "text": "da sitz ich allein"
  },
  {
   "start": 141.55,
   "end": 143.76,
   "text": "auf meiner Terrasse"
  },
  {
   "start": 144.63,
   "end": 146.97,
   "text": "und trinke den Wein,"
  },
  {
   "start": 147.82,
   "end": 150.56,
   "text": "und esse die Reste"
  },
  {
   "start": 151.07,
   "end": 153.26,
   "text": "und r\u00e4keln mich m\u00fcd."
  },
  {
   "start": 153.79,
   "end": 159.31,
   "text": "Und sing mir selber noch das kleine Lied."
  },
  {
   "start": 160.53,
   "end": 165.94,
   "text": "Ich gab ein Tigerfest zu Haus in meinem Garten."
  },
  {
   "start": 167.25,
   "end": 172.01,
   "text": "Ein recht geselliges Beisammensein."
  },
  {
   "start": 173.49,
   "end": 176.2,
   "text": "Erst lie\u00df ich es starten,"
  },
  {
   "start": 176.96,
   "end": 179.48,
   "text": "dann kamen die Tiger."
  },
  {
   "start": 180.02,
   "end": 182.93,
   "text": "Die Menschen waren wehrlos."
  },
  {
   "start": 183.53,
   "end": 186.1,
   "text": "Die Tiger blieben Sieger."
  },
  {
   "start": 186.48,
   "end": 192.64,
   "text": "Ja, solche Feste find ich fein und sie gelingen allgemein."
  },
  {
   "start": 193.02,
   "end": 199.78,
   "text": "Ich lade euch alle, allerherzlichste ein."
  }
 ],
