 "lyrics": [
  {
   "start": 13.7,
   "end": 17.34,
   "text": "Einsamkeit hast du gemacht"
  },
  {
   "start": 17.34,
   "end": 20.69,
   "text": "Ich hab geweint du hast gelacht"
  },
  {
   "start": 20.69,
   "end": 23.94,
   "text": "Ich frag warum willst du mich nicht"
  },
  {
   "start": 23.94,
   "end": 27.27,
   "text": "schau mir doch wieder ins Gesicht"
  },
  {
   "start": 27.27,
   "end": 30.58,
   "text": "Ich hab gewacht die ganze Nacht"
  },
  {
   "start": 30.58,
   "end": 33.85,
   "text": "Ich hab kein Auge zugemacht"
  },
  {
   "start": 33.85,
   "end": 37.13,
   "text": "Ich wasch mich nicht von Gram erf\u00fcllt"
  },
  {
   "start": 37.13,
   "end": 43.62,
   "text": "seh ich im Glas mein Ebenbild"
  },
  {
   "start": 43.62,
   "end": 47.02,
   "text": "und sehe ich hab"
  },
  {
   "start": 47.02,
   "end": 50.25,
   "text": "Akne Ich hab Akne ich hab Akne"
  },
  {
   "start": 50.25,
   "end": 56.83,
   "text": "meine Poren sind verschmutzt und ganz verstopft"
  },
  {
   "start": 56.83,
   "end": 60.15,
   "text": "Meine Haut neigt zur Unreinheit"
  },
  {
   "start": 60.15,
   "end": 63.44,
   "text": "Oh mein Gott wie seh ich aus"
  },
  {
   "start": 63.44,
   "end": 66.7,
   "text": "Heimlich steh ich vorm Spiegel"
  },
  {
   "start": 66.7,
   "end": 70.05,
   "text": "dr\u00fcck mir einen Pickel aus"
  },
  {
   "start": 81.98,
   "end": 86.56,
   "text": "Doch dann eines Tages da kam sie"
  },
  {
   "start": 86.56,
   "end": 89.84,
   "text": "sie sagte Akne c'est la vie"
  },
  {
   "start": 89.84,
   "end": 93.13,
   "text": "Sie hat mit Pickeln kein Problem"
  },
  {
   "start": 93.13,
   "end": 96.36,
   "text": "nicht mit Furunkeln und nicht mit Ekzem"
  },
  {
   "start": 96.36,
   "end": 99.69,
   "text": "F\u00fcr sie z\u00e4hlt nicht die eigene H\u00e4rte"
  },
  {
   "start": 99.69,
   "end": 103.05,
   "text": "f\u00fcr sie z\u00e4hln nur die inneren Werte"
  },
  {
   "start": 103.05,
   "end": 106.33,
   "text": "Sie sagt sei mutig steh dazu"
  },
  {
   "start": 106.33,
   "end": 112.92,
   "text": "dr\u00fcck sie aus dann hast du Ruh"
  },
  {
   "start": 112.92,
   "end": 116.2,
   "text": "und darum ich hab"
  },
  {
   "start": 116.2,
   "end": 119.51,
   "text": "Akne ich hab Akne ich hab Akne"
  },
  {
   "start": 119.51,
   "end": 126.15,
   "text": "meine Poren sind verschmutzt und ganz verstopft"
  },
  {
   "start": 126.15,
   "end": 129.36,
   "text": "Meine Haut neigt zur Unreinheit"
  },
  {
   "start": 129.36,
   "end": 132.63,
   "text": "Oh mon Dieu wie seh ich aus"
  },
  {
   "start": 132.63,
   "end": 135.98,
   "text": "Heimlich steh ich vorm Spiegel"
  },
  {
   "start": 135.98,
   "end": 140.91,
   "text": "dr\u00fcck mir einen Pickel aus"
  },
  {
   "start": 146.51,
   "end": 150.79,
   "text": "Ihr habt Akne ihr hat Akne ihr hat Akne"
  },
  {
   "start": 150.79,
   "end": 157.33,
   "text": "und dazu ein kleines bi\u00dfchen Mundgeruch"
  },
  {
   "start": 157.33,
   "end": 160.6,
   "text": "Ja Ger\u00fcche und Ged\u00fcfte"
  },
  {
   "start": 160.6,
   "end": 163.95,
   "text": "die geh\u00f6rn zu einem Mann"
  },
  {
   "start": 163.95,
   "end": 167.26,
   "text": "darum lass ich wenn ich bei dir"
  },
  {
   "start": 167.26,
   "end": 173.44,
   "text": "liege meine"
  },
  {
   "start": 173.44,
   "end": 182.06,
   "text": "Stiefel an"
  }
 ],
