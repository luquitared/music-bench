 "lyrics": [
  {
   "end": 4.212,
   "start": 0.044,
   "text": "Ah, look at all the lonely people!"
  },
  {
   "end": 10.625,
   "start": 7.039,
   "text": "Ah, look at all the lonely people!"
  },
  {
   "end": 19.658,
   "start": 13.972,
   "text": "Eleanor Rigby picks up the rice in the church where a wedding has been"
  },
  {
   "end": 22.742,
   "start": 20.985,
   "text": "Lives in a dream"
  },
  {
   "end": 28.431,
   "start": 22.742,
   "text": "Waits at the window, wearing the face that she keeps in a jar by the door"
  },
  {
   "end": 31.345,
   "start": 29.669,
   "text": "Who is it for?"
  },
  {
   "end": 34.777,
   "start": 32.222,
   "text": "All the lonely people"
  },
  {
   "end": 38.234,
   "start": 35.61,
   "text": "Where do they all come from?"
  },
  {
   "end": 41.682,
   "start": 39.048,
   "text": "All the lonely people"
  },
  {
   "end": 44.576,
   "start": 42.533,
   "text": "Where do they all belong?"
  },
  {
   "end": 51.077,
   "start": 45.367,
   "text": "Father McKenzie writing the words of a sermon that no one will hear"
  },
  {
   "end": 54.093,
   "start": 52.369,
   "text": "No one comes near"
  },
  {
   "end": 59.734,
   "start": 54.093,
   "text": "Look at him working. Darning his socks in the night when there's nobody there"
  },
  {
   "end": 62.66,
   "start": 61.073,
   "text": "What does he care?"
  },
  {
   "end": 66.12,
   "start": 63.495,
   "text": "All the lonely people"
  },
  {
   "end": 69.591,
   "start": 66.968,
   "text": "Where do they all come from?"
  },
  {
   "end": 73.063,
   "start": 70.391,
   "text": "All the lonely people"
  },
  {
   "end": 75.736,
   "start": 73.841,
   "text": "Where do they all belong?"
  },
  {
   "end": 80.262,
   "start": 76.687,
   "text": "Ah, look at all the lonely people!"
  },
  {
   "end": 87.224,
   "start": 83.71,
   "text": "Ah, look at all the lonely people!"
  },
  {
   "end": 96.469,
   "start": 90.695,
   "text": "Eleanor Rigby died in the church and was buried along with her name"
  },
  {
   "end": 99.439,
   "start": 97.694,
   "text": "Nobody came"
  },
  {
   "end": 105.052,
   "start": 99.439,
   "text": "Father McKenzie wiping the dirt from his hands as he walks from the grave"
  },
  {
   "end": 107.882,
   "start": 106.404,
   "text": "No one was saved"
  },
  {
