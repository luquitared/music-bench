 "lyrics": [
  {
   "start": 18.24,
   "end": 22.08,
   "text": "He's a whistler when the wind blows"
  },
  {
   "start": 22.08,
   "end": 25.92,
   "text": "Keeps it simple, only whole notes"
  },
  {
   "start": 25.92,
   "end": 31.68,
   "text": "Plays his hollow reed effortlessly"
  },
  {
   "start": 35.52,
   "end": 39.36,
   "text": "He just sits there in the limbo"
  },
  {
   "start": 39.36,
   "end": 43.2,
   "text": "Doesn't listen, full of blow holes"
  },
  {
   "start": 43.2,
   "end": 50.88,
   "text": "Curtains waver, the old refrain repeats"
  },
  {
   "start": 53.76,
   "end": 57.6,
   "text": "A penny for a thought"
  },
  {
   "start": 57.6,
   "end": 61.44,
   "text": "For pounds of flesh he bought"
  },
  {
   "start": 61.44,
   "end": 68.16,
   "text": "A peso for one not to confess here"
  },
  {
   "start": 69.12,
   "end": 72.96,
   "text": "The last shall be the first"
  },
  {
   "start": 72.96,
   "end": 76.8,
   "text": "The wordlessly coerced"
  },
  {
   "start": 76.8,
   "end": 83.52,
   "text": "And death is not the worst atrocity"
  },
  {
   "start": 86.4,
   "end": 90.24,
   "text": "There's a hissing through the window"
  },
  {
   "start": 90.24,
   "end": 94.08,
   "text": "Like a twisted virtuoso"
  },
  {
   "start": 94.08,
   "end": 100.8,
   "text": "Warning of a storm brewing again"
  },
  {
   "start": 103.68,
   "end": 107.52,
   "text": "To the victor goes the intro"
  },
  {
   "start": 107.52,
   "end": 111.36,
   "text": "Full of whispered innuendo"
  },
  {
   "start": 111.36,
   "end": 119.04,
   "text": "A time once more, a paranoid crusade"
  },
  {
   "start": 138.24,
   "end": 142.08,
   "text": "The past shall be reversed"
  },
  {
   "start": 142.08,
   "end": 145.92,
   "text": "The dead not so accursed"
  },
  {
   "start": 145.92,
   "end": 152.64,
   "text": "A universe rehearsed in tragedy"
  },
  {
   "start": 155.52,
   "end": 159.36,
   "text": "He's a whistler, he's a widow"
  },
  {
   "start": 159.36,
   "end": 163.2,
   "text": "Doesn't miss her, plays it solo"
  },
  {
   "start": 163.2,
   "end": 169.92,
   "text": "Blissfully ignoring his estate"
  },
  {
   "start": 172.8,
   "end": 176.64,
   "text": "Tears bitter on the pillow"
  },
  {
   "start": 176.64,
   "end": 180.48,
   "text": "Makes his mission not to know more"
  },
  {
   "start": 180.48,
   "end": 187.2,
   "text": "Curtains flutter, the old refrain repeats"
  },
  {
   "start": 190.08,
   "end": 198.72,
   "text": "Yeah, he's a whistler"
  },
  {
   "start": 207.36,
   "end": 211.2,
   "text": "He's a whistler"
  },
  {
   "start": 211.2,
   "end": 215.04,
   "text": "He's a whistler"
  },
  {
   "start": 215.04,
   "end": 224.64,
   "text": "Oh"
  }
 ],
