 "lyrics": [
  {
   "start": 18.3,
   "end": 22.4,
   "text": "He's a whistler when the wind blows"
  },
  {
   "start": 22.6,
   "end": 26.5,
   "text": "Keeps it simple, only whole notes"
  },
  {
   "start": 27.0,
   "end": 33.5,
   "text": "Plays his hollow tune effortlessly"
  },
  {
   "start": 35.0,
   "end": 39.0,
   "text": "He just sits there in limbo"
  },
  {
   "start": 39.3,
   "end": 43.3,
   "text": "Doesn't listen for the blowholes"
  },
  {
   "start": 43.6,
   "end": 51.8,
   "text": "Curtains waver, the old refrain repeats"
  },
  {
   "start": 53.5,
   "end": 57.5,
   "text": "A penny for a thought"
  },
  {
   "start": 57.6,
   "end": 61.5,
   "text": "For pounds of flesh he bought"
  },
  {
   "start": 62.0,
   "end": 69.0,
   "text": "A peso for what not to confess here"
  },
  {
   "start": 70.3,
   "end": 74.2,
   "text": "The last shall be the first"
  },
  {
   "start": 74.5,
   "end": 78.5,
   "text": "The wordlessly coerced"
  },
  {
   "start": 79.0,
   "end": 85.8,
   "text": "Death is not the worst atrocity"
  },
  {
   "start": 87.0,
   "end": 91.0,
   "text": "There's a hissing through the window"
  },
  {
   "start": 91.2,
   "end": 95.3,
   "text": "Like a twisted virtuoso"
  },
  {
   "start": 95.8,
   "end": 102.5,
   "text": "Warning of a storm brewing again"
  },
  {
   "start": 103.6,
   "end": 107.7,
   "text": "To the victor goes the intro"
  },
  {
   "start": 107.9,
   "end": 112.0,
   "text": "Full of whispered innuendo"
  },
  {
   "start": 112.4,
   "end": 120.5,
   "text": "A time once more for a paranoid crusade"
  },
  {
   "start": 138.8,
   "end": 142.8,
   "text": "The past shall be reversed"
  },
  {
   "start": 143.0,
   "end": 147.0,
   "text": "The dead not so accursed"
  },
  {
   "start": 147.4,
   "end": 154.5,
   "text": "A universe rehearsed in tragedy"
  },
  {
   "start": 155.4,
   "end": 159.5,
   "text": "He's a whistler, he's a widow"
  },
  {
   "start": 159.8,
   "end": 163.8,
   "text": "Doesn't miss her, plays it solo"
  },
  {
   "start": 164.4,
   "end": 171.0,
   "text": "Blissfully ignoring his instinct"
  },
  {
   "start": 172.0,
   "end": 176.2,
   "text": "Tears bitter on a pillow"
  },
  {
   "start": 176.5,
   "end": 180.5,
   "text": "Makes his mission not to know more"
  },
  {
   "start": 181.0,
   "end": 188.5,
   "text": "Curtains flutter, the old refrain repeats"
  },
  {
   "start": 191.2,
   "end": 198.8,
   "text": "Yeah, he's a whistler"
  },
  {
   "start": 207.0,
   "end": 211.2,
   "text": "He's a whistler"
  },
  {
   "start": 211.4,
   "end": 215.5,
   "text": "He's a whistler"
  },
  {
   "start": 216.0,
   "end": 224.2,
   "text": "Oh"
  }
 ],
