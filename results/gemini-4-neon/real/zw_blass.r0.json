 "lyrics": [
  {
   "start": 40.5,
   "end": 44.5,
   "text": "Ich bin etwas blass,"
  },
  {
   "start": 45.0,
   "end": 49.5,
   "text": "findest du nicht?"
  },
  {
   "start": 50.0,
   "end": 57.0,
   "text": "Der Fr\u00fchling ist noch immer nicht in Sicht."
  },
  {
   "start": 57.8,
   "end": 61.8,
   "text": "Ein bisschen blass,"
  },
  {
   "start": 62.0,
   "end": 65.5,
   "text": "und die Haut auch rau,"
  },
  {
   "start": 66.2,
   "end": 72.5,
   "text": "und kein Lied auf den Lippen, schau."
  },
  {
   "start": 73.5,
   "end": 80.5,
   "text": "Ich hab Gefallen am Herbst gefunden,"
  },
  {
   "start": 80.8,
   "end": 86.8,
   "text": "und auch an den Winter gew\u00f6hnt man sich."
  },
  {
   "start": 87.2,
   "end": 95.5,
   "text": "Ich bin ja nicht arm und krank und geschunden,"
  },
  {
   "start": 96.2,
   "end": 100.0,
   "text": "aber etwas blass,"
  },
  {
   "start": 100.0,
   "end": 104.8,
   "text": "findest du nicht?"
  },
  {
   "start": 105.5,
   "end": 107.0,
   "text": "Drei, vier"
  },
  {
   "start": 132.5,
   "end": 138.8,
   "text": "Ich hab Gefallen am Herbst gefunden,"
  },
  {
