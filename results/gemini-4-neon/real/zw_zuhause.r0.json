 "lyrics": [
  {
   "start": 10.4,
   "end": 11.3,
   "text": "Wow!"
  },
  {
   "start": 22.2,
   "end": 24.8,
   "text": "Ich bin kein Tourist"
  },
  {
   "start": 25.1,
   "end": 27.5,
   "text": "Ich dachte einmal"
  },
  {
   "start": 27.7,
   "end": 30.4,
   "text": "Dass das Ziel im Wege ist"
  },
  {
   "start": 30.6,
   "end": 33.2,
   "text": "Die Adresse egal"
  },
  {
   "start": 33.4,
   "end": 36.2,
   "text": "Mit jedem Weg verliert man"
  },
  {
   "start": 36.3,
   "end": 38.9,
   "text": "Ein Herz und ein Jahr"
  },
  {
   "start": 39.0,
   "end": 41.8,
   "text": "Das Herz w\u00e4chst nur langsam"
  },
  {
   "start": 41.9,
   "end": 45.0,
   "text": "Ein Jahr nie mehr nach"
  },
  {
   "start": 45.8,
   "end": 50.5,
   "text": "Es w\u00e4chst nie mehr nach"
  },
  {
   "start": 60.7,
   "end": 63.0,
   "text": "Morgen bin ich weg"
  },
  {
   "start": 63.2,
   "end": 65.7,
   "text": "Und du wei\u00dft, was das hei\u00dft"
  },
  {
   "start": 65.8,
   "end": 68.6,
   "text": "Drei, vier Koffer im Gep\u00e4ck"
  },
  {
   "start": 68.8,
   "end": 71.5,
   "text": "Aber nicht nur verreist"
  },
  {
   "start": 71.8,
   "end": 74.2,
   "text": "Tief, tief im Westen"
  },
  {
   "start": 74.3,
   "end": 76.9,
   "text": "Ist es besser, als man glaubt"
  },
  {
   "start": 77.2,
   "end": 79.8,
   "text": "Doch ihr wisst am besten"
  },
  {
   "start": 79.9,
   "end": 83.5,
   "text": "Dass man nicht viel zu glauben braucht"
  },
  {
   "start": 84.2,
   "end": 88.0,
   "text": "Zu glauben braucht"
  },
  {
   "start": 88.3,
   "end": 92.2,
   "text": "Liebe, Freiheit, Sex und Eifersucht"
  },
  {
   "start": 93.8,
   "end": 98.0,
   "text": "Sind gro\u00dfe Worte, meistens fett gedruckt"
  },
  {
   "start": 98.2,
   "end": 100.8,
   "text": "Allein"
  },
  {
   "start": 100.8,
   "end": 105.0,
   "text": "Das Wort Zuhause steht ganz klein"
  },
  {
   "start": 105.6,
   "end": 107.7,
   "text": "Wei\u00df auf wei\u00df"
  },
  {
   "start": 107.9,
   "end": 111.2,
   "text": "Zwischen den Zeilen"
  },
  {
   "start": 151.2,
   "end": 153.8,
   "text": "Matze, mach's gut"
  },
  {
   "start": 154.0,
   "end": 156.6,
   "text": "Ich schenk dir mein Klavier"
  },
  {
   "start": 156.8,
   "end": 159.2,
   "text": "So leid es mir tut"
  },
  {
   "start": 159.4,
   "end": 162.5,
   "text": "Es bleibt lieber hier"
  },
  {
   "start": 163.5,
   "end": 167.5,
   "text": "Bleibt lieber hier"
  },
  {
   "start": 167.5,
   "end": 171.5,
   "text": "Liebe, Freiheit, Sex und Eifersucht"
  },
  {
   "start": 172.8,
   "end": 177.0,
   "text": "Sind gro\u00dfe Worte, meistens fett gedruckt"
  },
  {
