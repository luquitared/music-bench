 "lyrics": [
  {
   "start": 12.8,
   "end": 18.5,
   "text": "Ich geb ein Tigerfest zu Haus in meinem Garten"
  },
  {
   "start": 18.8,
   "end": 24.2,
   "text": "Ich lad euch alle dazu herzlichst ein"
  },
  {
   "start": 24.8,
   "end": 27.7,
   "text": "Die Fraun solln noch warten"
  },
  {
   "start": 27.8,
   "end": 30.8,
   "text": "Die M\u00e4nner solln kommen"
  },
  {
   "start": 30.9,
   "end": 33.7,
   "text": "Nicht gleich die Verliebten"
  },
  {
   "start": 33.8,
   "end": 36.7,
   "text": "Erst nehm ich die Frommen"
  },
  {
   "start": 37.0,
   "end": 39.9,
   "text": "Da gibt es Zucker, Brot und Wein"
  },
  {
   "start": 40.0,
   "end": 42.8,
   "text": "Und ganz spezielle Leckerein"
  },
  {
   "start": 43.0,
   "end": 48.0,
   "text": "Ihr werdet alle sehr zufrieden sein"
  },
  {
   "start": 49.0,
   "end": 54.5,
   "text": "Und bei dem Tigerfest zu Haus in meinem Garten"
  },
  {
   "start": 54.9,
   "end": 60.2,
   "text": "Da gibt's Musik und Tanz und Liebelei"
  },
  {
   "start": 60.8,
   "end": 63.6,
   "text": "Essen muss nicht entarten"
  },
  {
   "start": 63.8,
   "end": 66.6,
   "text": "Wir sind nicht in Eile"
  },
  {
   "start": 66.8,
   "end": 69.6,
   "text": "Ich kriege schon Schwung rein"
  },
  {
   "start": 69.8,
   "end": 72.6,
   "text": "Wenn ich euch verteile"
  },
  {
   "start": 72.8,
   "end": 75.7,
   "text": "Es kommt ein jeder an die Reih"
  },
  {
   "start": 75.8,
   "end": 78.6,
   "text": "Mit allerliebst und allerlei"
  },
  {
   "start": 78.8,
   "end": 83.8,
   "text": "Ihr f\u00fchlt euch sicher alle wohl dabei"
  },
  {
   "start": 84.2,
   "end": 87.5,
   "text": "Und dann kommen die Tiger"
  },
  {
   "start": 87.7,
   "end": 90.6,
   "text": "Aus ihrem Versteck"
  },
  {
   "start": 91.2,
   "end": 93.9,
   "text": "Da werdet ihr schreien"
  },
  {
   "start": 94.1,
   "end": 96.2,
   "text": "Ein paar laufen weg"
  },
  {
   "start": 97.0,
   "end": 99.8,
   "text": "Doch lie\u00df ich schon lange"
  },
  {
   "start": 100.0,
   "end": 102.5,
   "text": "Die Tore versperrn"
  },
  {
   "start": 103.2,
   "end": 105.7,
   "text": "Denn die Tiger haben Hunger"
  },
  {
   "start": 105.8,
   "end": 108.8,
   "text": "Und sie fressen gern"
  },
  {
   "start": 109.8,
   "end": 112.4,
   "text": "Sie werden euch verspeisen"
  },
  {
   "start": 112.7,
   "end": 115.1,
   "text": "Zuerst alle Fraun"
  },
  {
   "start": 115.5,
   "end": 118.2,
   "text": "Danach alle Weisen"
  },
  {
   "start": 118.5,
   "end": 121.0,
   "text": "Und dann alle Schlaun"
  },
  {
   "start": 121.7,
   "end": 124.4,
   "text": "Als letztes die Dummen"
  },
  {
   "start": 124.8,
   "end": 127.5,
   "text": "Ja, da hilft keine List"
  },
  {
   "start": 127.8,
   "end": 133.0,
   "text": "Solang bis keiner von euch \u00fcbrig ist"
  },
  {
   "start": 134.3,
   "end": 137.2,
   "text": "Ein paar Stunden sp\u00e4ter"
  },
  {
   "start": 137.7,
   "end": 140.2,
   "text": "Da sitz ich allein"
  },
  {
   "start": 140.6,
   "end": 143.4,
   "text": "Auf meiner Terrasse"
  },
  {
   "start": 143.8,
   "end": 146.4,
   "text": "Und trinke den Wein"
  },
  {
   "start": 146.8,
   "end": 149.7,
   "text": "Und esse die Reste"
  },
  {
   "start": 150.2,
   "end": 152.8,
   "text": "Und r\u00e4kle mich m\u00fcd"
  },
  {
   "start": 153.3,
   "end": 158.8,
   "text": "Und sing mir selber noch das kleine Lied"
  },
  {
   "start": 160.4,
   "end": 166.2,
   "text": "Ich gab ein Tigerfest zu Haus in meinem Garten"
  },
  {
   "start": 166.6,
   "end": 172.2,
   "text": "Ein recht geselliges Beisammensein"
  },
  {
   "start": 173.0,
   "end": 176.0,
   "text": "Erst lie\u00df ich es starten"
  },
  {
   "start": 176.3,
   "end": 179.2,
   "text": "Dann kamen die Tiger"
  },
  {
   "start": 179.6,
   "end": 182.5,
   "text": "Die Menschen warn wehrlos"
  },
  {
   "start": 182.8,
   "end": 185.8,
   "text": "Die Tiger bliebn Sieger"
  },
  {
   "start": 186.6,
   "end": 189.7,
   "text": "Ja, solche Feste find ich fein"
  },
  {
   "start": 190.0,
   "end": 192.8,
   "text": "Und sie gelingen allgemein"
  },
  {
   "start": 193.1,
   "end": 199.6,
   "text": "Ich lad euch alle, alle herzlichst ein"
  }
 ],
