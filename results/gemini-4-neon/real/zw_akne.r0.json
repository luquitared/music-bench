 "lyrics": [
  {
   "start": 13.6,
   "end": 16.4,
   "text": "Einsamkeit, hast du gemacht,"
  },
  {
   "start": 16.7,
   "end": 19.8,
   "text": "ich hab geweint und du hast gelacht."
  },
  {
   "start": 20.2,
   "end": 23.3,
   "text": "Ich frag warum, willst du mich nicht?"
  },
  {
   "start": 23.7,
   "end": 26.9,
   "text": "Schau mir doch wieder ins Gesicht!"
  },
  {
   "start": 27.2,
   "end": 30.2,
   "text": "Ich hab gewacht die ganze Nacht,"
  },
  {
   "start": 30.6,
   "end": 33.7,
   "text": "ich hab kein Auge zugemacht."
  },
  {
   "start": 34.1,
   "end": 37.2,
   "text": "Ich wasch mich nicht, von Gram erf\u00fcllt,"
  },
  {
   "start": 37.5,
   "end": 43.0,
   "text": "seh ich im Glas mein Ebenbild."
  },
  {
   "start": 43.5,
   "end": 44.9,
   "text": "Und sehe:"
  },
  {
   "start": 45.0,
   "end": 49.5,
   "text": "Ich hab Akne, ich hab Akne, ich hab Akne!"
  },
  {
   "start": 49.7,
   "end": 55.9,
   "text": "Meine Poren sind verschmutzt und ganz verstopft."
  },
  {
   "start": 56.4,
   "end": 59.9,
   "text": "Meine Haut neigt zu Unreinheit,"
  },
  {
   "start": 60.2,
   "end": 63.1,
   "text": "oh mein Gott, wie seh ich aus?"
  },
  {
   "start": 63.3,
   "end": 66.4,
   "text": "Heimlich stehe ich vorm Spiegel,"
  },
  {
   "start": 66.6,
   "end": 70.6,
   "text": "dr\u00fcck mir einen Pickel aus."
  },
  {
   "start": 82.0,
   "end": 85.1,
   "text": "Doch dann eines Tages, da kam sie,"
  },
  {
   "start": 85.4,
   "end": 88.4,
   "text": "sie sagte: Akne, c'est la vie!"
  },
  {
   "start": 88.8,
   "end": 91.9,
   "text": "Sie hat mit Pickeln kein Problem,"
  },
  {
   "start": 92.2,
   "end": 95.5,
   "text": "nicht mit Furunkeln und nicht mit Ekzem."
  },
  {
   "start": 95.8,
   "end": 98.9,
   "text": "F\u00fcr sie z\u00e4hlt nicht die eigne H\u00e4rte,"
  },
  {
   "start": 99.2,
   "end": 102.3,
   "text": "f\u00fcr sie z\u00e4hln nur die inneren Werte."
  },
  {
   "start": 102.6,
   "end": 105.8,
   "text": "Sie sagt: Sei mutig, steh dazu,"
  },
  {
   "start": 106.2,
   "end": 111.5,
   "text": "dr\u00fcck sie aus, dann hast du Ruh!"
  },
  {
   "start": 112.1,
   "end": 113.5,
   "text": "Und darum:"
  },
  {
   "start": 113.6,
   "end": 118.2,
   "text": "Ich hab Akne, ich hab Akne, ich hab Akne!"
  },
  {
   "start": 118.4,
   "end": 124.5,
   "text": "Meine Poren sind verschmutzt und ganz verstopft."
  },
  {
   "start": 125.0,
   "end": 128.5,
   "text": "Meine Haut neigt zu Unreinheit,"
  },
  {
   "start": 128.8,
   "end": 131.9,
   "text": "oh mon dieu, wie seh ich aus?"
  },
  {
   "start": 132.1,
   "end": 135.2,
   "text": "Heimlich stehe ich vorm Spiegel,"
  },
  {
   "start": 135.4,
   "end": 139.2,
   "text": "dr\u00fcck mir einen Pickel aus."
  },
  {
   "start": 145.9,
   "end": 149.8,
   "text": "Ihr habt Akne, ihr habt Akne, ihr habt Akne!"
  },
  {
   "start": 150.0,
   "end": 155.8,
   "text": "Und dazu ein kleines bisschen Mundgeruch."
  },
  {
   "start": 156.5,
   "end": 159.9,
   "text": "Ja, Ger\u00fcche und Ged\u00fcfte,"
  },
  {
   "start": 160.2,
   "end": 163.2,
   "text": "die geh\u00f6rn zu einem Mann."
  },
  {
   "start": 163.5,
   "end": 170.8,
   "text": "Darum lass ich, wenn ich bei dir liege, meine"
  },
  {
   "start": 174.3,
   "end": 181.8,
   "text": "Stiefel an!"
  }
 ],
