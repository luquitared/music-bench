 "lyrics": [
  {
   "start": 12.0,
   "end": 15.5,
   "text": "When I find myself in times of trouble"
  },
  {
   "start": 15.8,
   "end": 18.9,
   "text": "Mother Mary comes to me"
  },
  {
   "start": 19.2,
   "end": 22.0,
   "text": "Speaking words of wisdom"
  },
  {
   "start": 22.2,
   "end": 24.4,
   "text": "Let it be"
  },
  {
   "start": 25.3,
   "end": 28.5,
   "text": "And in my hour of darkness"
  },
  {
   "start": 28.6,
   "end": 32.0,
   "text": "She is standing right in front of me"
  },
  {
   "start": 32.3,
   "end": 35.0,
   "text": "Speaking words of wisdom"
  },
  {
   "start": 35.3,
   "end": 37.6,
   "text": "Let it be"
  },
  {
   "start": 37.8,
   "end": 45.2,
   "text": "Let it be, let it be, let it be, let it be"
  },
  {
   "start": 45.5,
   "end": 48.2,
   "text": "Whisper words of wisdom"
  },
  {
   "start": 48.4,
   "end": 50.8,
   "text": "Let it be"
  },
  {
   "start": 51.6,
   "end": 55.1,
   "text": "And when the broken hearted people"
  },
