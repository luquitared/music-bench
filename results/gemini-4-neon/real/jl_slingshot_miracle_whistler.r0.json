 "lyrics": [
  {
   "start": 17.8,
   "end": 20.4,
   "text": "He's a whistler"
  },
  {
   "start": 20.4,
   "end": 22.4,
   "text": "when the wind blows"
  },
  {
   "start": 22.5,
   "end": 24.5,
   "text": "Keeps it simple,"
  },
  {
   "start": 24.8,
   "end": 26.8,
   "text": "only whole notes"
  },
  {
   "start": 27.0,
   "end": 33.8,
   "text": "Plays his hollow tune effortlessly"
  },
  {
   "start": 35.1,
   "end": 37.5,
   "text": "He just sits there"
  },
  {
   "start": 37.7,
   "end": 39.7,
   "text": "in limbo"
  },
  {
   "start": 40.0,
   "end": 41.8,
   "text": "Doesn't listen"
  },
  {
   "start": 42.2,
   "end": 44.2,
   "text": "for the blow holes"
  },
  {
   "start": 44.4,
   "end": 51.8,
   "text": "Curtains waver, the old refrain repeats"
  },
  {
   "start": 52.7,
   "end": 56.8,
   "text": "A penny for a thought"
  },
  {
   "start": 57.1,
   "end": 61.0,
   "text": "For pounds of flesh he bought"
  },
  {
   "start": 61.4,
   "end": 69.2,
   "text": "A peso forward, not to confess here"
  },
  {
   "start": 69.9,
   "end": 74.2,
   "text": "The last shall be the first"
  },
  {
   "start": 74.4,
   "end": 78.4,
   "text": "Wordlessly coerced"
  },
  {
   "start": 78.7,
   "end": 86.6,
   "text": "Death is not the worst atrocity"
  },
  {
   "start": 87.0,
   "end": 89.5,
   "text": "There's a hissing"
  },
  {
   "start": 89.7,
   "end": 91.7,
   "text": "through the window"
  },
  {
   "start": 91.9,
   "end": 93.9,
   "text": "Like a twisted"
  },
  {
   "start": 94.2,
   "end": 96.2,
   "text": "virtuoso"
  },
  {
   "start": 96.4,
   "end": 103.4,
   "text": "Warning of a storm brewing again"
  },
  {
   "start": 104.2,
   "end": 106.7,
   "text": "To the victor"
  },
  {
   "start": 107.0,
   "end": 109.0,
   "text": "goes the intro"
  },
  {
   "start": 109.2,
   "end": 111.2,
   "text": "Full of whispered"
  },
  {
   "start": 111.5,
   "end": 113.4,
   "text": "innuendo"
  },
  {
   "start": 113.4,
   "end": 120.8,
   "text": "A time once more for a paranoid crusade"
  },
  {
   "start": 139.0,
   "end": 143.2,
   "text": "The past shall be reversed"
  },
  {
   "start": 143.4,
   "end": 147.4,
   "text": "The dead not so accursed"
  },
  {
   "start": 147.7,
   "end": 155.6,
   "text": "A universe rehearsed in tragedy"
  },
  {
   "start": 155.8,
   "end": 158.2,
   "text": "He's a whistler,"
  },
  {
   "start": 158.4,
   "end": 160.4,
   "text": "he's a widow"
  },
  {
   "start": 160.6,
   "end": 162.5,
   "text": "Doesn't miss her,"
  },
  {
   "start": 162.8,
   "end": 164.8,
   "text": "plays it solo"
  },
  {
   "start": 165.0,
   "end": 172.2,
   "text": "Blissfully ignoring his instinct"
  },
  {
   "start": 173.0,
   "end": 175.5,
   "text": "Tears bitter"
  },
  {
   "start": 175.7,
   "end": 177.7,
   "text": "on the pillow"
  },
  {
   "start": 177.9,
   "end": 179.9,
   "text": "Makes his mission"
  },
  {
   "start": 180.2,
   "end": 182.2,
   "text": "not to know more"
  },
  {
   "start": 182.4,
   "end": 189.8,
   "text": "Curtains flutter, the old refrain repeats"
  },
  {
   "start": 191.2,
   "end": 193.8,
   "text": "Yeah"
  },
  {
   "start": 194.0,
   "end": 199.0,
   "text": "He's a whistler"
  },
  {
   "start": 207.4,
   "end": 211.5,
   "text": "He's a whistler"
  },
  {
   "start": 211.9,
   "end": 215.8,
   "text": "He's a whistler"
  },
  {
   "start": 216.2,
   "end": 224.0,
   "text": "Oh"
  }
 ],
