 "lyrics": [
  {
   "start": 19.4,
   "end": 21.7,
   "text": "People gon' hate, let 'em do it"
  },
  {
   "start": 21.7,
   "end": 24.1,
   "text": "Shine like it ain't nothing to it"
  },
  {
   "start": 24.1,
   "end": 26.5,
   "text": "Damn, you a major influence"
  },
  {
   "start": 26.5,
   "end": 29.1,
   "text": "Skate like they ain't nothing doing, live life, don't say nothing to 'em"
  },
  {
   "start": 29.1,
   "end": 31.5,
   "text": "People gon' hate, let 'em do it"
  },
  {
   "start": 31.5,
   "end": 33.9,
   "text": "Shine like it ain't nothing to it"
  },
  {
   "start": 33.9,
   "end": 36.3,
   "text": "Damn, you a major influence"
  },
  {
   "start": 36.3,
   "end": 38.8,
   "text": "Skate like they ain't nothing doing, live life, don't say nothing to 'em"
  },
  {
   "start": 38.8,
   "end": 41.0,
   "text": "People telling lies on me"
  },
  {
   "start": 41.0,
   "end": 43.4,
   "text": "Feeling like Pac, all eyes on me"
  },
  {
   "start": 43.4,
   "end": 45.6,
   "text": "What my next rhyme gon' be?"
  },
  {
   "start": 45.6,
   "end": 48.4,
   "text": "Though motherfuckers never ever gon' shine off me"
  },
  {
   "start": 48.4,
   "end": 50.8,
   "text": "Wait for it, wait for it, wait for it"
  },
  {
   "start": 50.8,
   "end": 53.2,
   "text": "Don't worry, my haters is gon' pay for it"
  },
  {
   "start": 53.2,
   "end": 55.7,
   "text": "Chase dreams while dumb niggas'll chase whores"
  },
  {
   "start": 55.7,
   "end": 58.1,
   "text": "Overseas on a great tour, or"
  },
  {
   "start": 58.1,
   "end": 60.2,
   "text": "Maybe I'm just dreaming"
  },
  {
   "start": 60.2,
   "end": 62.9,
   "text": "It beats being with demons or niggas that's scheming"
  },
  {
   "start": 62.9,
   "end": 65.1,
   "text": "At least I'm thinking of an achievement"
  },
  {
   "start": 65.1,
   "end": 67.6,
   "text": "People talk shit for four seasons for no reason"
  },
  {
   "start": 67.6,
   "end": 70.0,
   "text": "People dog LeBron 'til LeBron show up"
  },
  {
   "start": 70.0,
   "end": 72.3,
   "text": "When he steps on the paint, then they guards go up"
  },
  {
   "start": 72.3,
   "end": 74.7,
   "text": "Scores go up, all the applause go up"
  },
  {
   "start": 74.7,
   "end": 77.5,
   "text": "And everybody in the whole damn court goes nuts"
  },
  {
   "start": 77.5,
   "end": 79.9,
   "text": "People gon' hate, let 'em do it"
  },
  {
   "start": 79.9,
   "end": 82.4,
   "text": "Shine like it ain't nothing to it"
  },
  {
