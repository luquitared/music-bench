 "lyrics": [
  {
   "start": 0.0,
   "end": 4.5,
   "text": "Ah, look at all the lonely people"
  },
  {
   "start": 6.9,
   "end": 11.5,
   "text": "Ah, look at all the lonely people"
  },
  {
   "start": 13.8,
   "end": 19.6,
   "text": "Eleanor Rigby picks up the rice in the church where a wedding has been"
  },
  {
   "start": 20.5,
   "end": 22.3,
   "text": "Lives in a dream"
  },
  {
   "start": 22.5,
   "end": 28.4,
   "text": "Waits at the window, wearing the face that she keeps in a jar by the door"
  },
  {
   "start": 29.2,
   "end": 31.0,
   "text": "Who is it for?"
  },
  {
   "start": 31.1,
   "end": 33.4,
   "text": "All the lonely people"
  },
  {
   "start": 33.7,
   "end": 36.8,
   "text": "Where do they all come from?"
  },
  {
   "start": 38.0,
   "end": 40.3,
   "text": "All the lonely people"
  },
  {
   "start": 40.6,
   "end": 43.7,
   "text": "Where do they all belong?"
  },
  {
   "start": 45.0,
   "end": 50.8,
   "text": "Father McKenzie writing the words of a sermon that no one will hear"
  },
  {
   "start": 51.8,
   "end": 53.6,
   "text": "No one comes near"
  },
  {
   "start": 53.8,
   "end": 59.6,
   "text": "Look at him working, darning his socks in the night when there's nobody there"
  },
  {
   "start": 60.5,
   "end": 62.2,
   "text": "What does he care?"
  },
  {
