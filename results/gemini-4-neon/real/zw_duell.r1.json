 "lyrics": [
  {
   "start": 15.5,
   "end": 22.5,
   "text": "Gn\u00e4diges Fr\u00e4ulein, ich bitte um Verzeihung"
  },
  {
   "start": 23.1,
   "end": 29.5,
   "text": "und um einen Augenblick Geh\u00f6r."
  },
  {
   "start": 30.6,
   "end": 37.3,
   "text": "Es ist die Frage von dringlicher Bedeutung"
  },
  {
   "start": 38.2,
   "end": 44.0,
   "text": "und sie lastet in mir schwer."
  },
  {
   "start": 46.1,
   "end": 51.8,
   "text": "Der Zufall lenkte meine Schritte"
  },
  {
   "start": 53.0,
   "end": 58.5,
   "text": "gestern an den Ostseestrand,"
  },
  {
   "start": 59.6,
   "end": 66.1,
   "text": "wo ich Sie dann in dessen wei\u00dfer Mitte"
  },
  {
   "start": 67.0,
   "end": 72.6,
   "text": "mit 'nem anderen Manne fand."
  },
  {
   "start": 73.7,
   "end": 80.5,
   "text": "Oh zarte Hand, warst stets selbst dir Schmuck und Zierde,"
  },
  {
   "start": 81.3,
   "end": 88.5,
   "text": "nun erdr\u00fcckt durch des Ringes Last."
  },
  {
   "start": 88.9,
   "end": 95.0,
   "text": "Und es gibt nichts, was ich nicht tuen w\u00fcrde,"
  },
  {
   "start": 95.4,
   "end": 103.5,
   "text": "jener Mann ist mir zutiefst verhasst."
  },
  {
   "start": 104.6,
   "end": 108.0,
   "text": "Bestellen Sie Ihrem Verlobten,"
  },
  {
   "start": 108.3,
   "end": 111.5,
   "text": "ich fordere ihn zum Duell."
  },
  {
   "start": 112.1,
   "end": 116.8,
   "text": "Zwar schie\u00df' ich nicht zum Vergn\u00fcgen,"
  },
  {
   "start": 117.9,
   "end": 120.8,
   "text": "aber schnell, aber schnell, aber schnell!"
  },
  {
   "start": 141.3,
   "end": 148.2,
   "text": "Gehetzt die Wolken, gepeitscht die Ostseewellen"
  },
  {
   "start": 148.8,
   "end": 154.2,
   "text": "von dem Sturm, der jeden Laut zerrei\u00dft."
  },
  {
   "start": 155.8,
   "end": 162.8,
   "text": "Die graue D\u00e4mm'rung allein sieht die Gesellen"
  },
  {
   "start": 163.5,
   "end": 169.5,
   "text": "als zwei Schatten auf des Strandes Wei\u00df."
  },
  {
   "start": 170.6,
   "end": 175.5,
   "text": "Indes durchf\u00e4hrt's die Jungfrau wie ein Beben,"
  },
  {
   "start": 177.5,
   "end": 183.4,
   "text": "denn sie erf\u00e4hrt, wohin der Freiherr fuhr."
  },
  {
   "start": 184.5,
   "end": 190.7,
   "text": "Schnell, Kutscher, schneller! Es geht um Tod und Leben!"
  },
  {
   "start": 191.7,
   "end": 198.3,
   "text": "Ach, und ging' es doch um ihres nur."
  },
  {
   "start": 199.8,
   "end": 203.0,
   "text": "Bestellt sie doch ihrem Verlobten"
  },
  {
   "start": 203.4,
   "end": 206.8,
   "text": "die Nachricht, vor der ihr graut:"
  },
  {
   "start": 207.3,
   "end": 212.0,
   "text": "Einer von beiden muss sterben"
  },
  {
   "start": 213.1,
   "end": 216.8,
   "text": "und sie ist des M\u00f6rders Braut!"
  },
  {
   "start": 228.8,
   "end": 231.0,
   "text": "Ba-ba-da-bam-bam!"
  }
 ],
