   "end": 21.1,
   "text": "Yeah, yeah, yeah, stuck in your ear"
  },
  {
   "start": 21.3,
   "end": 23.8,
   "text": "Why is it every time"
  },
  {
   "start": 24.0,
   "end": 26.7,
   "text": "You say you do, you don't?"
  },
