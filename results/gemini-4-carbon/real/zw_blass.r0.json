   "text": "findest du nicht?"
  },
  {
   "start": 50.4,
   "end": 57.5,
   "text": "Der Fr\u00fchling ist noch immer nicht in Sicht"
  },
  {
   "start": 58.8,
   "end": 62.2,
   "text": "Ein bisschen blass"
  },
  {
   "start": 62.7,
   "end": 66.2,
   "text": "und die Haut auch rau"
  },
  {
   "start": 67.1,
   "end": 72.8,
   "text": "und kein Lied auf den Lippen, schau"
  },
  {
   "start": 73.9,
   "end": 80.5,
   "text": "Ich hab Gefallen am Herbst gefunden"
  },
  {
   "start": 80.9,
   "end": 87.2,
   "text": "und auch an den Winter gew\u00f6hnt man sich"
  },
  {
   "start": 87.7,
