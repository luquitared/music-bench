 "lyrics": [
  {
   "start": 10.7,
   "end": 11.5,
   "text": "Wow!"
  },
  {
   "start": 22.6,
   "end": 24.8,
   "text": "Ich bin kein Tourist"
  },
  {
   "start": 25.2,
   "end": 27.6,
   "text": "Ich dachte einmal"
  },
  {
   "start": 28.0,
   "end": 30.8,
   "text": "Dass das Ziel im Wege ist"
  },
  {
   "start": 31.0,
   "end": 33.6,
   "text": "Die Adresse egal"
  },
  {
   "start": 33.9,
   "end": 36.6,
   "text": "Mit jedem Weg verliert man"
  },
  {
   "start": 36.7,
   "end": 39.2,
   "text": "Ein Herz und ein Jahr"
  },
  {
   "start": 39.4,
   "end": 42.2,
   "text": "Das Herz w\u00e4chst nur langsam"
  },
  {
   "start": 42.4,
   "end": 45.8,
   "text": "Ein Jahr nie mehr nach"
  },
  {
   "start": 46.5,
   "end": 51.2,
   "text": "Es w\u00e4chst nie mehr nach"
  },
  {
   "start": 61.8,
   "end": 63.8,
   "text": "Morgen bin ich weg"
  },
  {
   "start": 64.0,
   "end": 66.8,
   "text": "Und du wei\u00dft, was das hei\u00dft"
  },
  {
   "start": 67.2,
   "end": 69.5,
   "text": "Drei, vier Koffer im Gep\u00e4ck"
  },
  {
   "start": 69.8,
   "end": 72.5,
   "text": "Aber nicht nur verreist"
  },
  {
   "start": 73.1,
   "end": 75.6,
   "text": "Tief, tief im Westen"
  },
  {
   "start": 75.8,
   "end": 78.4,
   "text": "Ist es besser, als man glaubt"
  },
  {
   "start": 78.6,
   "end": 81.4,
   "text": "Doch ihr wisst am besten"
  },
  {
   "start": 81.5,
   "end": 85.2,
   "text": "Dass man nicht viel zu glauben braucht"
  },
  {
   "start": 85.6,
   "end": 89.2,
   "text": "Zu glauben braucht"
  },
  {
   "start": 89.3,
   "end": 92.5,
   "text": "Liebe, Freiheit, Sex und Eifersucht"
  },
  {
   "start": 93.9,
   "end": 98.2,
   "text": "Sind gro\u00dfe Worte, meistens fett gedruckt"
  },
  {
   "start": 98.3,
   "end": 100.6,
   "text": "Allein"
  },
  {
   "start": 100.7,
   "end": 105.8,
   "text": "Das Wort Zuhause steht ganz klein"
