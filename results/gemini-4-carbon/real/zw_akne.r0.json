 "lyrics": [
  {
   "start": 13.75,
   "end": 17.5,
   "text": "Einsamkeit hast du gemacht,"
  },
  {
   "start": 17.5,
   "end": 20.6,
   "text": "ich hab geweint, du hast gelacht."
  },
  {
   "start": 20.8,
   "end": 24.1,
   "text": "Ich frag, warum willst du mich nicht?"
  },
  {
   "start": 24.2,
   "end": 27.6,
   "text": "Schau mir doch wieder ins Gesicht."
  },
  {
   "start": 27.7,
   "end": 31.0,
   "text": "Ich hab gewacht die ganze Nacht,"
  },
  {
   "start": 31.1,
   "end": 34.4,
   "text": "ich hab kein Auge zugemacht."
  },
  {
   "start": 34.6,
   "end": 37.9,
   "text": "Ich wasch mich nicht, von Gram erf\u00fcllt"
  },
  {
   "start": 38.0,
   "end": 43.5,
   "text": "seh ich im Glas mein Ebenbild."
  },
  {
   "start": 44.2,
   "end": 47.15,
   "text": "Und seh: Ich hab"
  },
  {
   "start": 47.18,
   "end": 50.2,
   "text": "Akne, ich hab Akne, ich hab Akne,"
  },
  {
   "start": 50.2,
   "end": 56.2,
   "text": "meine Poren sind verschmutzt und ganz verstopft."
  },
  {
   "start": 56.6,
   "end": 59.9,
   "text": "Meine Haut neigt zu Unreinheit,"
  },
  {
   "start": 60.0,
   "end": 63.6,
   "text": "oh mein Gott, wie seh ich aus!"
  },
  {
   "start": 63.8,
   "end": 67.1,
   "text": "Heimlich steh ich vorm Spiegel,"
  },
  {
   "start": 67.2,
   "end": 71.2,
   "text": "dr\u00fcck mir einen Pickel aus."
  },
  {
   "start": 82.3,
   "end": 86.0,
   "text": "Doch dann eines Tages, da kam sie,"
  },
  {
   "start": 86.1,
   "end": 89.3,
   "text": "sie sagte: Akne, c'est la vie."
  },
  {
   "start": 89.5,
   "end": 92.8,
   "text": "Sie hat mit Pickeln kein Problem,"
  },
  {
   "start": 92.9,
   "end": 96.2,
   "text": "nicht mit Furunkeln und nicht mit Ekzem."
  },
  {
   "start": 96.4,
   "end": 99.7,
   "text": "F\u00fcr sie z\u00e4hlt nicht die eigne H\u00e4rte,"
  },
  {
   "start": 99.8,
   "end": 103.2,
   "text": "f\u00fcr sie z\u00e4hlen nur die inneren Werte."
  },
  {
   "start": 103.3,
   "end": 106.6,
   "text": "Sie sagt: Sei mutig, steh dazu,"
  },
  {
   "start": 106.7,
   "end": 112.0,
   "text": "dr\u00fcck sie aus, dann hast du Ruh."
  },
  {
   "start": 112.7,
   "end": 115.7,
   "text": "Und darum: Ich hab"
  },
  {
   "start": 115.75,
   "end": 118.8,
   "text": "Akne, ich hab Akne, ich hab Akne,"
  },
  {
   "start": 118.8,
   "end": 124.8,
   "text": "meine Poren sind verschmutzt und ganz verstopft."
  },
  {
   "start": 125.2,
   "end": 128.4,
   "text": "Meine Haut neigt zu Unreinheit,"
  },
  {
   "start": 128.5,
   "end": 132.3,
   "text": "oh mon Dieu, wie seh ich aus!"
  },
  {
   "start": 132.4,
   "end": 135.7,
   "text": "Heimlich steh ich vorm Spiegel,"
  },
  {
   "start": 135.8,
   "end": 139.8,
   "text": "dr\u00fcck mir einen Pickel aus."
  },
  {
   "start": 146.5,
   "end": 150.4,
   "text": "Er hat Akne, er hat Akne, er hat Akne,"
  },
  {
   "start": 150.4,
   "end": 155.8,
   "text": "und dazu ein kleines bisschen Mundgeruch."
  },
  {
   "start": 156.6,
   "end": 160.2,
   "text": "Ja, Ger\u00fcche und Ged\u00fcfte,"
  },
  {
   "start": 160.3,
   "end": 163.9,
   "text": "die geh\u00f6ren zu einem Mann."
  },
  {
   "start": 164.1,
   "end": 171.5,
   "text": "Darum lass ich, wenn ich bei dir liege, meine"
  },
  {
   "start": 174.5,
   "end": 181.5,
   "text": "Stiefel an."
  }
 ],
