 "lyrics": [
  {
   "start": 19.2,
   "end": 23.2,
   "text": "He's a whistler when the wind blows"
  },
  {
   "start": 23.4,
   "end": 27.5,
   "text": "Keeps it simple, only whole notes"
  },
  {
   "start": 27.8,
   "end": 35.0,
   "text": "Plays his hollow tune effortlessly"
  },
  {
   "start": 36.2,
   "end": 40.3,
   "text": "He just sits there in limbo"
  },
  {
   "start": 40.6,
   "end": 44.6,
   "text": "Doesn't listen, full of blowholes"
  },
  {
   "start": 45.0,
   "end": 52.2,
   "text": "Curtains waver, the old refrain repeats"
  },
  {
   "start": 53.5,
   "end": 57.5,
   "text": "A penny for a thought"
  },
  {
   "start": 57.8,
   "end": 61.8,
   "text": "For pounds of flesh he bought"
  },
  {
   "start": 62.1,
   "end": 69.5,
   "text": "A peso for what not to confess here"
  },
  {
   "start": 70.6,
   "end": 74.7,
   "text": "The last shall be the first"
  },
  {
   "start": 75.0,
   "end": 79.0,
   "text": "The wordlessly coerced"
  },
  {
   "start": 79.3,
   "end": 86.8,
   "text": "And death is not the worst atrocity"
  },
  {
   "start": 87.8,
   "end": 91.8,
   "text": "There's a hissing through the window"
  },
  {
   "start": 92.1,
   "end": 96.1,
   "text": "Like a twisted virtuoso"
  },
  {
   "start": 96.4,
   "end": 103.5,
   "text": "Warning of a storm brewing again"
  },
  {
   "start": 104.8,
   "end": 108.9,
   "text": "To the victor goes the intro"
  },
  {
   "start": 109.2,
   "end": 113.2,
   "text": "Full of whispered innuendo"
  },
  {
   "start": 113.5,
   "end": 121.2,
   "text": "A time once more, a paranoid crusade"
  },
  {
   "start": 139.2,
   "end": 143.3,
   "text": "The past shall be reversed"
  },
  {
   "start": 143.6,
   "end": 147.6,
   "text": "The dead not so accursed"
  },
  {
   "start": 147.9,
   "end": 155.5,
   "text": "A universe immersed in tragedy"
  },
  {
   "start": 156.3,
   "end": 160.4,
   "text": "He's a whistler, he's a widow"
  },
  {
   "start": 160.6,
   "end": 164.6,
   "text": "Doesn't miss her, plays it solo"
  },
  {
   "start": 164.9,
   "end": 172.0,
   "text": "Blissfully ignoring he's insane"
  },
  {
   "start": 173.5,
   "end": 177.5,
   "text": "Tears bitter on the pillow"
  },
  {
   "start": 177.8,
   "end": 181.8,
   "text": "Makes his mission not to follow"
  },
  {
   "start": 182.2,
   "end": 189.5,
   "text": "Curtains flutter, the old refrain repeats"
  },
  {
   "start": 191.8,
   "end": 194.8,
   "text": "Yeah"
  },
  {
   "start": 195.0,
   "end": 199.5,
   "text": "He's a whistler"
  },
  {
   "start": 207.8,
   "end": 212.0,
   "text": "He's a whistler"
  },
  {
   "start": 212.1,
   "end": 216.2,
   "text": "He's a whistler"
  },
  {
   "start": 216.5,
   "end": 225.0,
   "text": "Oh"
  }
 ],
