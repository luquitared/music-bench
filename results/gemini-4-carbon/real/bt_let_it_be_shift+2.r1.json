 "lyrics": [
  {
   "start": 13.1,
   "end": 16.5,
   "text": "When I find myself in times of trouble"
  },
  {
   "start": 16.6,
   "end": 19.8,
   "text": "Mother Mary comes to me"
  },
  {
   "start": 20.0,
   "end": 24.2,
   "text": "Speaking words of wisdom, let it be"
  },
  {
   "start": 26.1,
   "end": 29.9,
   "text": "And in my hour of darkness she is standing"
  },
  {
   "start": 30.0,
   "end": 32.8,
   "text": "right in front of me"
  },
  {
   "start": 33.1,
   "end": 37.5,
   "text": "Speaking words of wisdom, let it be"
  },
  {
   "start": 38.2,
   "end": 45.8,
   "text": "Let it be, let it be, let it be, let it be"
  },
  {
   "start": 46.3,
   "end": 50.8,
   "text": "Whisper words of wisdom, let it be"
  },
  {
   "start": 51.8,
   "end": 55.9,
   "text": "And when the broken hearted people"
  },
  {
   "start": 56.0,
   "end": 59.2,
   "text": "living in the world agree"
  },
  {
   "start": 59.5,
   "end": 64.2,
   "text": "There will be an answer, let it be"
  },
  {
   "start": 65.3,
   "end": 68.5,
   "text": "For though they may be parted"
  },
  {
   "start": 68.7,
   "end": 72.5,
   "text": "there is still a chance that they will see"
  },
  {
   "start": 72.8,
   "end": 77.2,
   "text": "There will be an answer, let it be"
  },
  {
   "start": 78.0,
   "end": 85.6,
