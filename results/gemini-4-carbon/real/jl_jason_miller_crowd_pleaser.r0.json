 "lyrics": [
  {
   "start": 19.8,
   "end": 22.0,
   "text": "People gon' hate, let 'em do it"
  },
  {
   "start": 22.1,
   "end": 24.3,
   "text": "Shine like it ain't nothin' to it"
  },
  {
   "start": 24.4,
   "end": 25.5,
   "text": "Damn, you a major influence"
  },
  {
   "start": 25.6,
   "end": 28.9,
   "text": "Skate like they ain't nothin' doin', live life, don't say nothin' to 'em"
  },
  {
   "start": 29.5,
   "end": 31.7,
   "text": "People gon' hate, let 'em do it"
  },
  {
   "start": 31.8,
   "end": 34.0,
   "text": "Shine like it ain't nothin' to it"
  },
  {
   "start": 34.1,
   "end": 35.3,
   "text": "Damn, you a major influence"
  },
  {
   "start": 35.4,
   "end": 38.6,
   "text": "Skate like they ain't nothin' doin', live life, don't say nothin' to 'em"
  },
  {
   "start": 39.2,
   "end": 41.3,
   "text": "People tellin' lies on me"
  },
  {
   "start": 41.5,
   "end": 43.8,
   "text": "Feelin' like Pac, all eyes on me"
  },
  {
   "start": 44.0,
   "end": 46.0,
   "text": "What my next rhyme gon' be?"
  },
  {
   "start": 46.1,
   "end": 48.6,
   "text": "Though motherfuckers never ever gon' shine off me"
  },
  {
   "start": 48.7,
   "end": 51.1,
   "text": "Wait for it, wait for it, wait for it"
  },
  {
   "start": 51.2,
   "end": 53.5,
   "text": "Don't worry, my haters is gon' pay for it"
  },
  {
   "start": 53.6,
   "end": 56.0,
   "text": "Chase dreams while dumb niggas'll chase whores"
  },
  {
   "start": 56.1,
   "end": 58.3,
   "text": "Overseas on a great tour"
  },
  {
   "start": 58.4,
   "end": 60.5,
   "text": "Or maybe I'm just dreamin'"
  },
  {
   "start": 60.6,
   "end": 63.3,
   "text": "It beats bein' with demons, all niggas is schemin'"
  },
  {
   "start": 63.4,
   "end": 65.4,
   "text": "At least I'm thinkin' of an achievement"
  },
  {
   "start": 65.5,
   "end": 68.0,
   "text": "People talk shit for four seasons for no reason"
  },
  {
   "start": 68.1,
   "end": 70.4,
   "text": "People dog LeBron 'til LeBron show up"
  },
  {
   "start": 70.5,
   "end": 72.6,
   "text": "When he steps on the paint, then they guards go up"
  },
  {
   "start": 72.7,
   "end": 74.8,
   "text": "Scores go up, all the applause go up"
  },
  {
   "start": 74.9,
   "end": 77.6,
   "text": "And everybody in the whole damn court goes nuts"
  },
  {
   "start": 77.9,
   "end": 80.1,
   "text": "People gon' hate, let 'em do it"
  },
  {
