 "lyrics": [
  {
   "start": 18.75,
   "end": 20.6,
   "text": "Lay awake at night"
  },
  {
   "start": 20.95,
   "end": 23.0,
   "text": "Wondering how could I"
  },
  {
   "start": 23.25,
   "end": 25.5,
   "text": "Let it get this way"
  },
  {
   "start": 27.8,
   "end": 29.6,
   "text": "Through all the pain"
  },
  {
   "start": 29.85,
   "end": 32.0,
   "text": "I took all the blame"
  },
  {
   "start": 32.2,
   "end": 34.6,
   "text": "While you cursed my last name"
  },
  {
   "start": 36.25,
   "end": 38.6,
   "text": "I thought we could get better"
  },
  {
   "start": 38.75,
   "end": 40.95,
   "text": "Stay committed like a soldier"
  },
  {
   "start": 41.0,
   "end": 43.3,
   "text": "Believe we're okay"
  },
  {
   "start": 45.2,
   "end": 50.8,
   "text": "Now I know that you don't care"
  },
  {
   "start": 51.1,
   "end": 54.0,
   "text": "At all"
  },
  {
   "start": 54.25,
   "end": 56.2,
   "text": "Time wasted"
  },
  {
   "start": 56.35,
   "end": 58.8,
   "text": "Gave all of my soul and my heart"
  },
  {
   "start": 58.85,
   "end": 61.5,
   "text": "To someone that would never"
  },
  {
   "start": 61.55,
   "end": 63.1,
   "text": "Give me the same"
  },
  {
   "start": 63.15,
   "end": 65.15,
   "text": "I was a fool"
  },
  {
   "start": 65.25,
   "end": 67.65,
   "text": "To believe that you would"
  },
  {
   "start": 67.7,
   "end": 70.45,
   "text": "Finally be the one to"
  },
  {
   "start": 70.5,
   "end": 72.05,
   "text": "Give me the same"
  },
  {
   "start": 72.1,
   "end": 76.2,
   "text": "Heartbroken now"
  },
