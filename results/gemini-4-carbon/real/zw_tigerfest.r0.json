 "lyrics": [
  {
   "start": 12.8,
   "end": 18.2,
   "text": "Ich geb ein Tigerfest zu Haus in meinem Garten"
  },
  {
   "start": 19.0,
   "end": 24.2,
   "text": "Ich lad euch alle dazu herzlichst ein"
  },
  {
   "start": 25.1,
   "end": 27.5,
   "text": "Die Frau'n soll'n noch warten"
  },
  {
   "start": 28.1,
   "end": 30.6,
   "text": "Die M\u00e4nner soll'n kommen"
  },
  {
   "start": 31.2,
   "end": 33.7,
   "text": "Nicht gleich die Verliebten"
  },
  {
   "start": 34.2,
   "end": 36.8,
   "text": "Erst nehm ich die Frommen"
  },
  {
   "start": 37.2,
   "end": 43.2,
   "text": "Da gibt es Zuckerbrot und Wein und ganz spezielle Leckerei'n"
  },
  {
   "start": 43.3,
   "end": 48.5,
   "text": "Ihr werdet alle sehr zufrieden sein"
  },
  {
   "start": 49.3,
   "end": 54.5,
   "text": "Und bei dem Tigerfest zu Haus in meinem Garten"
  },
  {
   "start": 55.3,
   "end": 60.5,
   "text": "Da gibt's Musik und Tanz und Liebelei"
  },
  {
   "start": 61.3,
   "end": 63.8,
   "text": "Es muss nicht entarten"
  },
  {
   "start": 64.2,
   "end": 66.8,
   "text": "Wir sind nicht in Eile"
  },
  {
   "start": 67.2,
   "end": 69.7,
   "text": "Ich kriege schon Schwung rein"
  },
  {
   "start": 69.8,
   "end": 72.8,
   "text": "Wenn ich euch verteile"
  },
  {
   "start": 73.3,
   "end": 79.1,
   "text": "Es kommt ein jeder an die Reih' mit Allerliebsten und allerlei"
  },
  {
   "start": 79.2,
   "end": 84.5,
   "text": "Ihr f\u00fchlt euch sicher alle wohl dabei"
  },
  {
   "start": 85.1,
   "end": 90.8,
   "text": "Dann kommen die Tiger aus ihrem Versteck"
  },
  {
   "start": 91.3,
   "end": 96.8,
   "text": "Da werdet ihr schreien, ein paar laufen weg"
  },
  {
   "start": 97.3,
   "end": 102.8,
   "text": "Doch lie\u00df ich schon lange die Tore versperr'n"
  },
  {
   "start": 103.3,
   "end": 109.2,
   "text": "Denn die Tiger haben Hunger und sie fressen gern"
  },
  {
   "start": 110.2,
   "end": 115.6,
   "text": "Sie werd'n euch verspeisen, zuerst alle Frau'n"
  },
  {
   "start": 116.1,
   "end": 121.6,
   "text": "Danach alle Weisen und dann alle Schlau'n"
  },
  {
   "start": 122.1,
   "end": 127.6,
   "text": "Als Letztes die Dummen, ja da hilft keine List"
  },
  {
   "start": 128.1,
   "end": 134.0,
   "text": "So lang bis keiner von euch \u00fcbrig ist"
  },
  {
   "start": 135.0,
   "end": 140.4,
   "text": "Ein paar Stunden sp\u00e4ter, da sitz ich allein"
  },
  {
   "start": 140.9,
   "end": 146.4,
   "text": "Auf meiner Terrasse und trinke den Wein"
  },
  {
   "start": 146.9,
   "end": 152.4,
   "text": "Und esse die Reste und r\u00e4kle mich m\u00fcd"
  },
  {
   "start": 152.9,
   "end": 159.5,
   "text": "Und sing mir selber noch das kleine Lied"
  },
  {
   "start": 160.7,
   "end": 166.2,
   "text": "Ich gab ein Tigerfest zu Haus in meinem Garten"
  },
  {
   "start": 166.9,
   "end": 172.2,
   "text": "Ein recht geselliges Beisammensein"
  },
  {
   "start": 173.3,
   "end": 176.0,
   "text": "Erst lie\u00df ich es starten"
  },
  {
   "start": 176.5,
   "end": 179.5,
   "text": "Dann kamen die Tiger"
  },
  {
   "start": 180.0,
   "end": 183.0,
   "text": "Die Menschen war'n wehrlos"
  },
  {
   "start": 183.5,
   "end": 186.5,
   "text": "Die Tiger blieben Sieger"
  },
  {
   "start": 186.7,
   "end": 193.2,
   "text": "Ja, solche Feste find ich fein und sie gelingen allgemein"
  },
  {
   "start": 193.4,
   "end": 200.0,
   "text": "Ich lad euch alle, alle herzlichst ein"
  }
 ],
