 "lyrics": [
  {
   "start": 18.06,
   "end": 20.0,
   "text": "Lay awake at night"
  },
  {
   "start": 20.15,
   "end": 22.35,
   "text": "Wondering how could I"
  },
  {
   "start": 22.5,
   "end": 24.6,
   "text": "Let it get this way"
  },
  {
   "start": 26.94,
   "end": 28.9,
   "text": "Through all the pain"
  },
  {
   "start": 29.05,
   "end": 31.25,
   "text": "I took all the blame"
  },
  {
   "start": 31.39,
   "end": 33.61,
   "text": "While you cursed my last name"
  },
  {
   "start": 35.65,
   "end": 37.9,
   "text": "I thought we could get better"
  },
  {
   "start": 38.06,
   "end": 40.15,
   "text": "Stay committed like a soldier"
  },
  {
   "start": 40.28,
   "end": 42.5,
   "text": "Believe we're okay"
  },
  {
   "start": 44.72,
   "end": 50.6,
   "text": "Now I know that you don't care"
  },
  {
   "start": 50.8,
   "end": 53.4,
   "text": "At all"
  },
  {
   "start": 53.61,
   "end": 55.2,
   "text": "Time wasted"
  },
  {
   "start": 55.35,
   "end": 61.2,
   "text": "Gave all of my soul and my heart to someone that would never"
  },
  {
   "start": 61.1,
   "end": 62.45,
   "text": "Give me the same"
  },
  {
   "start": 62.5,
   "end": 64.15,
   "text": "I was a fool"
  },
  {
   "start": 64.25,
   "end": 69.8,
   "text": "To believe that you would finally be the one to"
  },
  {
   "start": 69.95,
   "end": 71.35,
   "text": "Give me the same"
  },
  {
   "start": 71.39,
   "end": 75.5,
   "text": "Heartbroken now"
  },
  {
   "start": 75.83,
   "end": 79.8,
   "text": "How you let me down"
  },
  {
   "start": 80.0,
   "end": 82.3,
   "text": "But somehow"
  },
  {
   "start": 82.5,
   "end": 85.9,
   "text": "Deep down I still do"
  },
  {
   "start": 86.2,
   "end": 89.0,
   "text": "Love you"
  },
  {
   "start": 91.39,
   "end": 93.35,
   "text": "Now you're out all night"
  },
  {
   "start": 93.61,
   "end": 95.5,
   "text": "Telling your lies"
  },
  {
   "start": 95.65,
