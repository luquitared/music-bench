 "lyrics": [
  {
   "start": 10.8,
   "end": 11.5,
   "text": "Wow!"
  },
  {
   "start": 22.8,
   "end": 25.0,
   "text": "Ich bin kein Tourist"
  },
  {
   "start": 25.2,
   "end": 28.0,
   "text": "Ich dachte einmal"
  },
  {
   "start": 28.0,
   "end": 30.8,
   "text": "Dass das Ziel im Wege ist"
  },
  {
   "start": 30.8,
   "end": 33.8,
   "text": "Die Adresse egal"
  },
  {
   "start": 34.0,
   "end": 36.8,
   "text": "Mit jedem Weg verliert man"
  },
  {
   "start": 36.8,
   "end": 39.3,
   "text": "Ein Herz und ein Jahr"
  },
  {
   "start": 39.3,
   "end": 42.1,
   "text": "Das Herz w\u00e4chst nur langsam"
  },
  {
   "start": 42.1,
   "end": 46.2,
   "text": "Ein Jahr nie mehr nach"
  },
  {
   "start": 46.4,
   "end": 50.8,
   "text": "Es w\u00e4chst nie mehr nach"
  },
  {
   "start": 60.6,
   "end": 62.5,
   "text": "Morgen bin ich weg"
  },
  {
   "start": 62.6,
   "end": 65.4,
   "text": "Und du wei\u00dft, was das hei\u00dft"
  },
  {
   "start": 65.5,
   "end": 68.2,
   "text": "Drei, vier Koffer im Gep\u00e4ck"
  },
  {
   "start": 68.3,
   "end": 71.2,
   "text": "Aber nicht nur verreist"
  },
  {
   "start": 71.8,
   "end": 74.3,
   "text": "Tief, tief im Westen"
  },
  {
   "start": 74.3,
