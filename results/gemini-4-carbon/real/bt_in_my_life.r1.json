 "lyrics": [
  {
   "start": 8.9,
   "end": 13.5,
   "text": "There are places I'll remember"
  },
  {
   "start": 13.8,
   "end": 18.5,
   "text": "All my life, though some have changed"
  },
  {
   "start": 18.6,
   "end": 22.8,
   "text": "Some forever, not for better"
  },
  {
   "start": 23.1,
   "end": 27.6,
   "text": "Some have gone and some remain"
  },
  {
   "start": 27.8,
   "end": 32.1,
   "text": "All these places have their moments"
  },
  {
   "start": 32.6,
   "end": 36.8,
   "text": "With lovers and friends I still can recall"
  },
  {
   "start": 37.1,
   "end": 41.3,
   "text": "Some are dead and some are living"
  },
  {
   "start": 41.9,
   "end": 46.2,
   "text": "In my life, I've loved them all"
  },
  {
   "start": 50.9,
   "end": 55.4,
   "text": "But of all these friends and lovers"
  },
  {
   "start": 55.7,
   "end": 60.2,
   "text": "There is no one compares with you"
  },
  {
   "start": 60.3,
   "end": 64.7,
   "text": "And these memories lose their meaning"
  },
  {
   "start": 65.0,
   "end": 69.6,
   "text": "When I think of love as something new"
  },
  {
   "start": 69.7,
   "end": 73.9,
   "text": "Though I know I'll never lose affection"
  },
  {
   "start": 74.4,
   "end": 78.6,
   "text": "For people and things that went before"
  },
  {
   "start": 78.9,
   "end": 83.1,
   "text": "I know I'll often stop and think about them"
  },
  {
   "start": 83.7,
   "end": 88.0,
   "text": "In my life, I love you more"
  },
  {
