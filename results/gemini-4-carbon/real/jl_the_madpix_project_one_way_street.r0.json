 "lyrics": [
  {
   "start": 14.0,
   "end": 17.5,
   "text": "Tears are like diamonds in my eyes"
  },
  {
   "start": 17.6,
   "end": 20.9,
   "text": "Blind me so, now you're out of sight"
  },
  {
   "start": 21.0,
   "end": 26.8,
   "text": "It's enough, it's too late to break this silence"
  },
  {
   "start": 27.8,
   "end": 31.2,
   "text": "In a rose-colored view of us"
  },
  {
   "start": 31.3,
   "end": 34.7,
   "text": "I got lost, could I realize"
  },
  {
   "start": 34.8,
   "end": 38.4,
   "text": "All your lies would be blades and knives"
  },
  {
   "start": 38.5,
   "end": 41.0,
   "text": "To stab me inside"
  },
  {
   "start": 41.5,
   "end": 44.8,
   "text": "Who will save you from this dark?"
  },
  {
   "start": 45.0,
   "end": 48.2,
   "text": "Who will fix your selfish heart?"
  },
  {
   "start": 48.3,
   "end": 51.2,
   "text": "A one-way street, that's how you live"
  },
  {
   "start": 51.3,
   "end": 54.8,
   "text": "Why do you always take and never give?"
  },
  {
   "start": 82.7,
   "end": 85.8,
   "text": "Wide awake, yeah, I've crossed the line"
  },
  {
   "start": 85.9,
   "end": 89.5,
   "text": "I'm coming home, I'm running back to real life"
  },
  {
   "start": 89.8,
   "end": 95.4,
   "text": "To the start where I could breathe in freely, baby"
  },
  {
   "start": 96.2,
   "end": 98.2,
   "text": "Can't you see we ran out of time?"
  },
  {
   "start": 98.3,
   "end": 102.5,
   "text": "Chasing happiness while you get what you need"
  },
  {
   "start": 103.0,
   "end": 106.8,
   "text": "There's nothing left of us but bleeding, blades and knives"
  },
  {
   "start": 106.9,
   "end": 109.5,
   "text": "Tonight you'll know how it feels"
  },
  {
   "start": 109.6,
   "end": 112.8,
   "text": "A one-way street, that's how you live"
  },
  {
   "start": 112.9,
   "end": 116.4,
   "text": "Why do you always take and never give?"
  },
  {
   "start": 116.5,
   "end": 119.8,
   "text": "I'll walk away to help you see"
  },
  {
   "start": 119.9,
   "end": 123.4,
   "text": "Our love is rolling down so easily"
  },
  {
   "start": 123.5,
   "end": 125.4,
   "text": "A one-way street"
  },
  {
   "start": 155.5,
   "end": 158.5,
   "text": "A one-way street"
  },
  {
   "start": 158.8,
   "end": 162.0,
   "text": "You never give"
  },
  {
   "start": 162.2,
   "end": 165.3,
   "text": "I'll walk away"
  },
  {
   "start": 165.6,
   "end": 169.8,
   "text": "So easily, a one-way street"
  }
 ],
