 "lyrics": [
  {
   "start": 13.0,
   "end": 16.3,
   "text": "When I find myself in times of trouble"
  },
  {
   "start": 16.3,
   "end": 19.5,
   "text": "Mother Mary comes to me"
  },
  {
   "start": 19.5,
   "end": 24.8,
   "text": "Speaking words of wisdom, let it be"
  },
  {
   "start": 25.8,
   "end": 29.1,
   "text": "And in my hour of darkness"
  },
  {
   "start": 29.1,
   "end": 32.2,
   "text": "She is standing right in front of me"
  },
  {
   "start": 32.2,
   "end": 37.5,
   "text": "Speaking words of wisdom, let it be"
  },
  {
   "start": 38.3,
   "end": 44.5,
   "text": "Let it be, let it be, let it be, let it be"
  },
  {
   "start": 45.2,
   "end": 50.2,
   "text": "Whisper words of wisdom, let it be"
  },
  {
   "start": 51.5,
   "end": 58.0,
   "text": "And when the broken hearted people living in the world agree"
  },
  {
   "start": 58.5,
   "end": 63.5,
   "text": "There will be an answer, let it be"
  },
  {
   "start": 65.0,
   "end": 67.8,
   "text": "For though they may be parted"
  },
  {
   "start": 67.8,
   "end": 71.3,
   "text": "There is still a chance that they will see"
  },
  {
   "start": 71.8,
   "end": 76.8,
   "text": "There will be an answer, let it be"
  },
  {
   "start": 77.8,
   "end": 84.2,
   "text": "Let it be, let it be, let it be, let it be"
  },
  {
   "start": 84.8,
   "end": 90.0,
   "text": "Yeah, there will be an answer, let it be"
  },
  {
   "start": 91.0,
