 "lyrics": [
  {
   "start": 13.3,
   "end": 18.6,
   "text": "Ich geb ein Tigerfest zu Haus in meinem Garten,"
  },
  {
   "start": 19.6,
   "end": 24.8,
   "text": "ich lad euch alle dazu herzlichst ein."
  },
  {
   "start": 25.4,
   "end": 27.6,
   "text": "Die Frau'n soll'n noch warten,"
  },
  {
   "start": 28.1,
   "end": 30.7,
   "text": "die M\u00e4nner soll'n kommen,"
  },
  {
   "start": 31.5,
   "end": 33.8,
   "text": "nicht gleich die Verliebten,"
  },
  {
   "start": 34.2,
   "end": 37.0,
   "text": "erst nehm ich die Frommen."
  },
  {
   "start": 37.2,
   "end": 43.4,
   "text": "Da gibt es Zuckerbrot und Wein und ganz spezielle Leckerei'n,"
  },
  {
   "start": 43.5,
   "end": 48.5,
   "text": "ihr werdet alle sehr zufrieden sein."
  },
  {
   "start": 49.5,
   "end": 54.8,
   "text": "Und bei dem Tigerfest zu Haus in meinem Garten,"
  },
  {
   "start": 55.6,
   "end": 60.8,
   "text": "da gibt's Musik und Tanz und Liebelei."
  },
  {
   "start": 61.7,
   "end": 64.0,
   "text": "Es muss nicht entarten,"
  },
  {
   "start": 64.5,
   "end": 67.0,
   "text": "wir sind nicht in Eile,"
  },
  {
   "start": 67.5,
   "end": 69.9,
   "text": "ich kriege schon Schwung rein,"
  },
  {
   "start": 70.0,
   "end": 73.1,
   "text": "wenn ich euch verteile."
  },
  {
   "start": 73.3,
   "end": 79.2,
   "text": "Es kommt ein jeder an die Reih mit Allerliebst und Schallerlei,"
  },
  {
   "start": 79.3,
   "end": 84.8,
   "text": "ihr f\u00fchlt euch sicher alle wohl dabei."
  },
  {
   "start": 85.4,
   "end": 88.2,
   "text": "Dann kommen die Tiger"
  },
  {
   "start": 88.5,
   "end": 91.2,
   "text": "aus ihrem Versteck,"
  },
  {
   "start": 91.5,
   "end": 94.2,
   "text": "da werdet ihr schreien,"
  },
  {
   "start": 94.6,
   "end": 97.0,
   "text": "ein paar laufen weg."
  },
  {
   "start": 97.6,
   "end": 100.2,
   "text": "Doch lie\u00df ich schon lange"
  },
  {
   "start": 100.6,
   "end": 103.1,
   "text": "die Tore versperr'n,"
  },
  {
   "start": 103.6,
   "end": 109.2,
   "text": "denn die Tiger hab'n Hunger und sie fressen gern."
  },
  {
   "start": 110.1,
   "end": 112.8,
   "text": "Sie werd'n euch verspeisen,"
  },
  {
   "start": 113.2,
   "end": 115.8,
   "text": "zuerst alle Frau'n,"
  },
  {
   "start": 116.2,
   "end": 118.8,
   "text": "danach alle Weisen"
  },
  {
   "start": 119.2,
   "end": 121.8,
   "text": "und alle Schlau'n."
  },
  {
   "start": 122.2,
   "end": 125.2,
   "text": "Als Letztes die Dummen,"
  },
  {
   "start": 125.4,
   "end": 128.0,
   "text": "ja, da hilft keine List,"
  },
  {
   "start": 128.3,
   "end": 134.2,
   "text": "so lang, bis keiner von euch \u00fcbrig ist."
  },
  {
   "start": 135.4,
   "end": 137.9,
   "text": "Ein paar Stunden sp\u00e4ter,"
  },
  {
   "start": 138.3,
   "end": 140.8,
   "text": "da sitz ich allein"
  },
  {
   "start": 141.4,
   "end": 143.9,
   "text": "auf meiner Terrasse"
  },
  {
   "start": 144.4,
   "end": 146.9,
   "text": "und trinke den Wein"
  },
  {
   "start": 147.4,
   "end": 150.0,
   "text": "und esse die Reste"
  },
  {
   "start": 150.4,
   "end": 153.2,
   "text": "und r\u00e4kel mich m\u00fcd"
  },
  {
   "start": 153.5,
   "end": 159.5,
   "text": "und sing mir selber noch das kleine Lied:"
  },
  {
   "start": 160.8,
   "end": 166.2,
   "text": "Ich gab ein Tigerfest zu Haus in meinem Garten,"
  },
  {
   "start": 167.0,
   "end": 172.4,
   "text": "ein recht geselliges Beisammensein."
  },
  {
   "start": 173.5,
   "end": 175.9,
   "text": "Erst lie\u00df ich es starten,"
  },
  {
   "start": 176.4,
   "end": 179.2,
   "text": "dann kamen die Tiger,"
  },
  {
   "start": 180.0,
   "end": 182.8,
   "text": "die Menschen war'n wehrlos,"
  },
  {
   "start": 183.0,
   "end": 186.2,
   "text": "die Tiger blieb'n Sieger."
  },
  {
   "start": 186.5,
   "end": 192.6,
   "text": "Ja, solche Feste find ich fein und sie gelingen allgemein,"
  },
  {
   "start": 192.8,
   "end": 200.2,
   "text": "ich lad euch alle, alle herzlichste ein."
  }
 ],
