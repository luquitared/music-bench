 "lyrics": [
  {
   "start": 13.0,
   "end": 18.2,
   "text": "Ich geb ein Tigerfest zu Haus in meinem Garten"
  },
  {
   "start": 19.0,
   "end": 24.0,
   "text": "Ich lad euch alle dazu herzlichst ein"
  },
  {
   "start": 25.1,
   "end": 27.6,
   "text": "Die Frauen soll noch warten"
  },
  {
   "start": 28.1,
   "end": 30.7,
   "text": "Die M\u00e4nner soll kommen"
  },
  {
   "start": 31.0,
   "end": 33.7,
   "text": "Nicht gleich die Verliebten"
  },
  {
   "start": 34.0,
   "end": 36.7,
   "text": "Erst nehm ich die Frommen"
  },
  {
   "start": 37.2,
   "end": 43.0,
   "text": "Da gibt es Zucker, Brot und Wein und ganz spezielle Leckereien"
  },
  {
   "start": 43.0,
   "end": 48.3,
   "text": "Ihr werdet alle sehr zufrieden sein"
  },
  {
   "start": 49.0,
   "end": 54.2,
   "text": "Und bei dem Tigerfest zu Haus in meinem Garten"
  },
  {
   "start": 55.0,
   "end": 60.2,
   "text": "Da gibt's Musik und Tanz und Liebelein"
  },
  {
   "start": 61.1,
   "end": 63.2,
   "text": "Es muss nicht entarten"
  },
  {
   "start": 63.9,
   "end": 66.5,
   "text": "Wir sind nicht in Eile"
  },
  {
   "start": 67.0,
   "end": 69.4,
   "text": "Ich kriege schon Schwung rein"
  },
  {
   "start": 69.8,
   "end": 72.5,
   "text": "Wenn ich euch verteile"
  },
  {
   "start": 73.0,
   "end": 78.8,
   "text": "Es kommt ein jeder an die Reih mit allerliebstem Schallerlei"
  },
  {
   "start": 78.8,
   "end": 84.5,
   "text": "Ihr f\u00fchlt euch sicher alle wohl dabei"
  },
  {
   "start": 85.0,
   "end": 87.7,
   "text": "Dann kommen die Tiger"
  },
  {
   "start": 88.1,
   "end": 90.5,
   "text": "Aus ihrem Versteck"
  },
  {
   "start": 91.3,
   "end": 93.9,
   "text": "Da werdet ihr schreien"
  },
  {
   "start": 94.4,
   "end": 96.2,
   "text": "Ein paar laufen weg"
  },
  {
   "start": 97.2,
   "end": 100.1,
   "text": "Doch lie\u00df ich schon lange"
  },
  {
   "start": 100.4,
   "end": 102.5,
   "text": "Die Tore versperren"
  },
  {
   "start": 103.4,
   "end": 109.0,
   "text": "Denn die Tiger haben Hunger und sie fressen gern"
  },
  {
   "start": 110.0,
   "end": 112.5,
   "text": "Sie werden euch verspeisen"
  },
  {
   "start": 113.0,
   "end": 115.2,
   "text": "Zuerst alle Frauen"
  },
  {
   "start": 116.2,
   "end": 118.5,
   "text": "Danach alle Weisen"
  },
  {
   "start": 119.0,
   "end": 121.2,
