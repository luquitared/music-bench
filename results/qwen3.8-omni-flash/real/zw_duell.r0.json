 "lyrics": [
  {
   "start": 16.0,
   "end": 23.0,
   "text": "Gn\u00e4diges Fr\u00e4ulein, ich bitt' um Verzeihung"
  },
  {
   "start": 23.0,
   "end": 30.0,
   "text": "Und um einen Augenblick Geh\u00f6r."
  },
  {
   "start": 30.0,
   "end": 38.0,
   "text": "Es ist die Frage von dringlicher Bedeutung"
  },
  {
   "start": 38.0,
   "end": 45.0,
   "text": "Und sie lastet in mir schwer."
  },
  {
   "start": 45.0,
   "end": 52.0,
   "text": "Der Zufall lenkte meine Schritte"
  },
  {
   "start": 52.0,
   "end": 59.0,
   "text": "Gestern an den Ostseestrand,"
  },
  {
   "start": 59.0,
   "end": 66.0,
   "text": "Wo ich Sie dann, indessen wei\u00dfer Mitte,"
  },
  {
   "start": 66.0,
   "end": 73.0,
   "text": "Mitten andern Manne fand."
  },
  {
   "start": 73.0,
   "end": 81.0,
   "text": "O zarte Hand, was stets selbst dir Schmuck und Zierde,"
  },
  {
   "start": 81.0,
   "end": 88.0,
   "text": "Nun erdr\u00fcckt durch des Ringes Last."
  },
  {
   "start": 88.0,
   "end": 95.0,
   "text": "Und es gibt nichts, was ich nicht thun w\u00fcrde,"
  },
  {
   "start": 95.0,
   "end": 104.0,
   "text": "Jener Mann ist mir zutiefst verha\u00dft."
  },
  {
   "start": 104.0,
   "end": 111.0,
   "text": "Bestellen Sie ihrem Verlobten, ich fordere ihn zum Duell."
  },
  {
   "start": 111.0,
   "end": 117.0,
   "text": "Zwar schie\u00df' ich nicht zum Vergn\u00fcgen,"
  },
  {
   "start": 117.0,
   "end": 121.0,
   "text": "Aber schnell, aber schnell, aber schnell!"
  },
  {
   "start": 141.0,
   "end": 148.0,
   "text": "Gehetzt die Wolken, gepeitscht die Ostseewellen"
  },
  {
   "start": 148.0,
   "end": 155.0,
   "text": "Von dem Sturm, der jeden Laut zerrei\u00dft."
  },
  {
   "start": 155.0,
   "end": 163.0,
   "text": "Die graue D\u00e4mmerung allein sieht die Gesellen,"
  },
  {
   "start": 163.0,
   "end": 170.0,
   "text": "Als zwei Schatten auf des Strandes Wei\u00df."
  },
  {
   "start": 170.0,
   "end": 177.0,
   "text": "Indes durchf\u00e4hrt's die Jungfrau wie ein Beben,"
  },
  {
   "start": 177.0,
   "end": 184.0,
   "text": "Wenn sie erf\u00e4hrt, wohin der Freier fuhr."
  },
  {
   "start": 184.0,
   "end": 191.0,
   "text": "Schnell, Kurt, schneller! Es geht um Tod und Leben!"
  },
  {
   "start": 191.0,
   "end": 199.0,
   "text": "Ach, und ging es doch um ihres nur!"
  },
  {
   "start": 199.0,
   "end": 207.0,
   "text": "Bestellen Sie doch ihrem Verlobten die Nachricht, vor der ihr graut:"
  },
  {
   "start": 207.0,
   "end": 213.0,
   "text": "Einer von beiden mu\u00df sterben,"
  },
  {
   "start": 213.0,
   "end": 217.0,
   "text": "Und sie ist des M\u00f6rders Braut!"
  }
 ],
