 "lyrics": [
  {
   "start": 8.5,
   "end": 12.5,
   "text": "There are places I remember"
  },
  {
   "start": 12.5,
   "end": 15.5,
   "text": "All my life"
  },
  {
   "start": 15.5,
   "end": 17.5,
   "text": "Though some have changed"
  },
  {
   "start": 17.5,
   "end": 21.5,
   "text": "Some forever, not for better"
  },
  {
   "start": 21.5,
   "end": 24.5,
   "text": "Some have gone"
  },
  {
   "start": 24.5,
   "end": 26.5,
   "text": "And some remain"
  },
  {
   "start": 26.5,
   "end": 31.5,
   "text": "All these places had their moments"
  },
  {
   "start": 31.5,
   "end": 35.5,
   "text": "With lovers and friends I still can recall"
  },
  {
   "start": 35.5,
   "end": 40.5,
   "text": "Some are dead and some are living"
  },
  {
   "start": 40.5,
   "end": 43.5,
   "text": "In my life"
  },
  {
   "start": 43.5,
   "end": 46.5,
   "text": "I've loved them all"
  },
  {
   "start": 50,
   "end": 54.5,
   "text": "But of all these friends and lovers"
  },
  {
   "start": 54.5,
   "end": 58.5,
   "text": "There is no one compares with you"
  },
  {
   "start": 58.5,
   "end": 63.5,
   "text": "And these memories lose their meaning"
  },
  {
   "start": 63.5,
   "end": 68.5,
   "text": "When I think of love as something new"
  },
  {
   "start": 68.5,
   "end": 73.5,
   "text": "Though I know I'll never lose affection"
  },
  {
   "start": 73.5,
   "end": 77.5,
   "text": "For people and things that went before"
  },
  {
   "start": 77.5,
   "end": 82.5,
   "text": "I know I'll often stop and think about them"
  },
  {
   "start": 82.5,
   "end": 85.5,
   "text": "In my life"
  },
  {
   "start": 85.5,
   "end": 88,
   "text": "I love you more"
