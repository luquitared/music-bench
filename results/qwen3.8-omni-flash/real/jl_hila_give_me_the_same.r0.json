 "lyrics": [
  {
   "start": 18.0,
   "end": 20.0,
   "text": "Lay awake at night"
  },
  {
   "start": 20.0,
   "end": 22.0,
   "text": "Wondering how could I"
  },
  {
   "start": 22.0,
   "end": 25.0,
   "text": "Let it get this way"
  },
  {
   "start": 27.0,
   "end": 29.0,
   "text": "Through all the pain"
  },
  {
   "start": 29.0,
   "end": 31.0,
   "text": "I took all the blame"
  },
  {
   "start": 31.0,
   "end": 34.0,
   "text": "While you cursed my last name"
  },
  {
   "start": 36.0,
   "end": 38.0,
   "text": "I thought we could get better"
  },
  {
   "start": 38.0,
   "end": 40.0,
   "text": "Stay committed like a soldier"
  },
  {
   "start": 40.0,
   "end": 43.0,
   "text": "Believed we're okay"
  },
  {
   "start": 44.0,
   "end": 52.0,
   "text": "Now I know that you don't care at all"
  },
  {
   "start": 53.0,
   "end": 55.0,
   "text": "Time wasted"
  },
  {
   "start": 55.0,
   "end": 57.0,
   "text": "Gave all of my soul and my heart"
  },
  {
   "start": 57.0,
   "end": 62.0,
   "text": "To someone that would never give me the same"
  },
  {
   "start": 62.0,
   "end": 64.0,
   "text": "I was a fool to believe that you"
  },
  {
   "start": 64.0,
   "end": 66.0,
   "text": "Would finally be the one to"
  },
  {
   "start": 66.0,
   "end": 71.0,
   "text": "Give me the same"
  },
  {
   "start": 71.0,
   "end": 75.0,
   "text": "Heartbroken now"
  },
  {
   "start": 75.0,
   "end": 79.0,
   "text": "How you let me down"
  },
  {
   "start": 79.0,
   "end": 82.0,
   "text": "But somehow"
  },
  {
   "start": 82.0,
   "end": 85.0,
   "text": "Deep down I still do"
  },
  {
   "start": 85.0,
   "end": 89.0,
   "text": "Love you"
  },
  {
   "start": 91.0,
   "end": 93.0,
   "text": "Now you're up all night"
  },
  {
   "start": 93.0,
   "end": 95.0,
   "text": "Telling your lies"
  },
  {
   "start": 95.0,
   "end": 98.0,
   "text": "About the way I hurt you"
  },
  {
   "start": 98.0,
   "end": 100.0,
   "text": "They couldn't see the way"
  },
  {
   "start": 100.0,
   "end": 102.0,
   "text": "You made me feel ashamed"
  },
  {
   "start": 102.0,
   "end": 105.0,
   "text": "For choosing to love you"
  },
  {
   "start": 107.0,
   "end": 109.0,
   "text": "I began to see clearer"
  },
  {
   "start": 109.0,
   "end": 111.0,
   "text": "That you were just a liar"
  },
  {
   "start": 111.0,
   "end": 114.0,
   "text": "Stuck in your ways"
  },
  {
   "start": 115.0,
   "end": 117.0,
   "text": "So now I"
  },
  {
   "start": 117.0,
   "end": 120.0,
   "text": "Choose to walk away"
  },
  {
   "start": 120.0,
   "end": 124.0,
   "text": "Forever"
  },
  {
   "start": 124.0,
   "end": 126.0,
   "text": "Time wasted"
  },
  {
   "start": 126.0,
   "end": 128.0,
   "text": "Gave all of my soul and my heart"
  },
  {
   "start": 128.0,
   "end": 133.0,
   "text": "To someone that would never give me the same"
  },
  {
   "start": 133.0,
   "end": 135.0,
   "text": "I was a fool to believe that you"
  },
  {
   "start": 135.0,
   "end": 137.0,
   "text": "Would finally be the one to"
  },
  {
   "start": 137.0,
   "end": 142.0,
