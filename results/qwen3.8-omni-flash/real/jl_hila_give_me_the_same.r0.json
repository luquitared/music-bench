  },
  {
   "start": 142.0,
   "end": 146.0,
   "text": "Heartbroken now"
  },
  {
   "start": 146.0,
   "end": 150.0,
   "text": "How you let me down"
  },
  {
   "start": 150.0,
   "end": 153.0,
   "text": "But somehow"
