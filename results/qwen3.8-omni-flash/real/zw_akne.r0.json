 "lyrics": [
  {
   "start": 13.5,
   "end": 16.0,
   "text": "Einsamkeit hast du gemacht"
  },
  {
   "start": 16.6,
   "end": 19.5,
   "text": "Ich hab geweint und du hast gelacht"
  },
  {
   "start": 20.0,
   "end": 23.2,
   "text": "Ich frag warum willst du mich nicht"
  },
  {
   "start": 23.5,
   "end": 26.5,
   "text": "Schau mir doch wieder ins Gesicht"
  },
  {
   "start": 26.9,
   "end": 29.8,
   "text": "Ich hab gewacht die ganze Nacht"
  },
  {
   "start": 30.3,
   "end": 33.3,
   "text": "Ich hab kein Auge zugemacht"
  },
  {
   "start": 33.7,
   "end": 36.8,
   "text": "Ich wasch mich nicht von Gramm erf\u00fcllt"
  },
  {
   "start": 37.2,
   "end": 43.5,
   "text": "Seh ich im Glas mein Ebenbild"
  },
  {
   "start": 43.8,
   "end": 46.3,
   "text": "Und sehe ich hab Akne"
  },
  {
   "start": 46.6,
   "end": 49.2,
   "text": "Ich hab Akne, ich hab Akne"
  },
  {
   "start": 49.4,
   "end": 55.8,
   "text": "Meine Poren sind verschmutzt und ganz verstopft"
  },
  {
   "start": 56.3,
   "end": 59.5,
   "text": "Meine Haut neigt zur Unreinheit"
  },
  {
   "start": 59.8,
   "end": 62.9,
   "text": "Oh mein Gott wie seh ich aus"
  },
  {
   "start": 63.2,
   "end": 66.3,
   "text": "Heimlich stehe ich vorm Spiegel"
  },
  {
   "start": 66.6,
   "end": 75.5,
   "text": "Dr\u00fcck mir einen Pickel aus"
  },
  {
   "start": 81.5,
   "end": 84.8,
   "text": "Doch dann eines Tages da kam sie"
  },
  {
   "start": 85.2,
   "end": 88.3,
   "text": "Sie sagte Akne c'est la vie"
  },
  {
   "start": 88.6,
   "end": 91.8,
   "text": "Sie hat mit Pickeln kein Problem"
  },
  {
   "start": 92.1,
   "end": 95.3,
   "text": "Nicht mit Furunkeln und nicht mit Ekzem"
  },
  {
   "start": 95.5,
   "end": 98.7,
   "text": "F\u00fcr sie z\u00e4hlt nicht die eigene H\u00e4rte"
  },
  {
   "start": 99.0,
   "end": 102.2,
   "text": "F\u00fcr sie z\u00e4hlen nur die inneren Werte"
  },
  {
   "start": 102.4,
   "end": 105.8,
   "text": "Sie sagt sei mutig steh dazu"
  },
  {
   "start": 106.1,
   "end": 112.0,
   "text": "Dr\u00fcck sie aus dann hast du Ruh"
  },
  {
   "start": 112.3,
   "end": 114.9,
   "text": "Und darum ich hab Akne"
  },
  {
   "start": 115.2,
   "end": 117.8,
   "text": "Ich hab Akne, ich hab Akne"
  },
  {
   "start": 118.1,
   "end": 124.5,
   "text": "Meine Poren sind verschmutzt und ganz verstopft"
  },
  {
   "start": 124.9,
   "end": 128.0,
   "text": "Meine Haut neigt zur Unreinheit"
  },
  {
   "start": 128.0,
   "end": 131.5,
   "text": "Oh mon Dieu wie seh ich aus"
  },
  {
   "start": 131.8,
   "end": 134.9,
   "text": "Heimlich stehe ich vorm Spiegel"
  },
  {
   "start": 135.2,
   "end": 142.5,
   "text": "Dr\u00fcck mir einen Pickel aus"
  },
  {
   "start": 146.2,
   "end": 149.7,
   "text": "Ihr habt Akne, ihr habt Akne, ihr habt Akne"
  },
  {
   "start": 149.9,
   "end": 155.5,
   "text": "Und dazu ein kleines bisschen Mundgeruch"
  },
  {
   "start": 156.7,
   "end": 163.2,
   "text": "Ja Ger\u00fcche und Ged\u00fcfte die geh\u00f6ren zu einem Mann"
  },
  {
   "start": 163.5,
   "end": 172.5,
   "text": "Darum lass ich wenn ich bei dir liege meine"
  },
  {
   "start": 174.5,
   "end": 181.5,
   "text": "Stiefel aus"
  }
 ],
