 ],
 "lyrics": [
  {
   "start": 13.0,
   "end": 18.0,
   "text": "Ich geb ein Tigerfest zu Haus in meinem Garten"
  },
  {
   "start": 19.0,
   "end": 24.0,
   "text": "Ich lad euch alle dazu herzlichst ein"
  },
  {
   "start": 25.0,
   "end": 27.0,
   "text": "Die Frauen soll'n noch warten"
  },
  {
   "start": 28.0,
   "end": 30.0,
   "text": "Die M\u00e4nner soll'n kommen"
  },
  {
   "start": 31.0,
   "end": 33.0,
   "text": "Nicht gleich die Verliebten"
  },
  {
   "start": 34.0,
   "end": 36.0,
   "text": "Erst nehm ich die Frommen"
  },
  {
   "start": 37.0,
   "end": 40.0,
   "text": "Da gibt es Zucker, Brot und Wein"
  },
  {
   "start": 40.0,
   "end": 43.0,
   "text": "Und ganz spezielle Leckereien"
  },
  {
   "start": 43.0,
   "end": 48.0,
   "text": "Ihr werdet alle sehr zufrieden sein"
  },
  {
   "start": 49.0,
   "end": 54.0,
   "text": "Und bei dem Tigerfest zu Haus in meinem Garten"
  },
  {
   "start": 55.0,
   "end": 60.0,
   "text": "Da gibt's Musik und Tanz und Liebelein"
  },
  {
   "start": 61.0,
   "end": 63.0,
   "text": "Essen muss nicht entarten"
  },
  {
   "start": 64.0,
   "end": 66.0,
   "text": "Wir sind nicht in Eile"
  },
  {
   "start": 67.0,
   "end": 69.0,
   "text": "Ich kriege schon Schwung rein"
  },
  {
   "start": 70.0,
   "end": 72.0,
   "text": "Wenn ich euch verteile"
  },
  {
   "start": 73.0,
   "end": 76.0,
   "text": "Es kommt ein jeder an die Reih'"
  },
  {
   "start": 76.0,
   "end": 79.0,
   "text": "Mit allerliebstem Schallerlei"
  },
  {
   "start": 79.0,
   "end": 84.0,
   "text": "Ihr f\u00fchlt euch sicher alle wohl dabei"
  },
  {
   "start": 85.0,
   "end": 90.0,
   "text": "Dann kommen die Tiger aus ihrem Versteck"
  },
  {
   "start": 91.0,
   "end": 96.0,
   "text": "Da werdet ihr schreien, ein paar laufen weg"
  },
  {
   "start": 97.0,
   "end": 102.0,
   "text": "Doch lie\u00df ich schon lange die Tore versperren"
  },
  {
   "start": 103.0,
   "end": 109.0,
   "text": "Denn die Tiger haben Hunger und sie fressen gern"
  },
  {
   "start": 110.0,
   "end": 115.0,
   "text": "Sie werden euch verspeisen, zuerst alle Frauen"
  },
  {
   "start": 116.0,
   "end": 121.0,
   "text": "Danach alle Weisen und dann alle Schlauen"
  },
  {
   "start": 122.0,
   "end": 127.0,
   "text": "Als letztes die Dummen, ja da hilft keine List"
  },
  {
   "start": 128.0,
   "end": 134.0,
   "text": "Solang bis keiner von euch \u00fcbrig ist"
  },
  {
   "start": 135.0,
   "end": 140.0,
   "text": "Ein paar Stunden sp\u00e4ter, da sitz ich allein"
  },
  {
   "start": 141.0,
   "end": 146.0,
   "text": "Auf meiner Terrasse und trinke den Wein"
  },
  {
   "start": 147.0,
   "end": 153.0,
   "text": "Und esse die Reste und regle mich m\u00fcd"
  },
  {
   "start": 154.0,
   "end": 159.0,
   "text": "Und sing mir selber noch das kleine Lied"
  },
  {
   "start": 160.0,
   "end": 166.0,
   "text": "Ich gab ein Tigerfest zu Haus in meinem Garten"
  },
  {
   "start": 167.0,
   "end": 172.0,
   "text": "Ein recht geselliges Beisammensein"
  },
  {
   "start": 173.0,
   "end": 176.0,
   "text": "Erst lie\u00df ich es starten"
  },
  {
   "start": 177.0,
   "end": 179.0,
   "text": "Dann kamen die Tiger"
  },
  {
   "start": 180.0,
   "end": 183.0,
   "text": "Die Menschen war'n wehrlos"
  },
  {
   "start": 183.0,
   "end": 186.0,
   "text": "Die Tiger blieben Sieger"
  },
  {
   "start": 187.0,
   "end": 190.0,
   "text": "Ja, solche Feste find ich fein"
  },
  {
   "start": 190.0,
   "end": 193.0,
   "text": "Und sie gelingen allgemein"
  },
  {
   "start": 193.0,
   "end": 199.0,
   "text": "Ich lad euch alle, alle herzlichste ein"
  }
 ],
