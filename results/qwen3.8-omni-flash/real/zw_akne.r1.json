 "lyrics": [
  {
   "start": 13.5,
   "end": 16.5,
   "text": "Einsamkeit hast du gemacht"
  },
  {
   "start": 16.5,
   "end": 19.5,
   "text": "Ich hab geweint und du hast gelacht"
  },
  {
   "start": 19.5,
   "end": 22.5,
   "text": "Ich frag warum willst du mich nicht"
  },
  {
   "start": 22.5,
   "end": 26.5,
   "text": "Schau mir doch wieder ins Gesicht"
  },
  {
   "start": 26.5,
   "end": 29.5,
   "text": "Ich hab gewacht die ganze Nacht"
  },
  {
   "start": 29.5,
   "end": 33.5,
   "text": "Ich hab kein Auge zugemacht"
  },
  {
   "start": 33.5,
   "end": 36.5,
   "text": "Ich wasch mich nicht, vom Gram erf\u00fcllt"
  },
  {
   "start": 36.5,
   "end": 43.5,
   "text": "Seh ich im Glas mein Ebenbild"
  },
  {
   "start": 43.9,
   "end": 45.8,
   "text": "Und sehe:"
  },
  {
   "start": 45.8,
   "end": 48.5,
   "text": "Ich hab Akne, ich hab Akne, ich hab Akne"
  },
  {
   "start": 48.5,
   "end": 55.5,
   "text": "Meine Poren sind verschmutzt und ganz verstopft"
  },
  {
   "start": 55.5,
   "end": 59.5,
   "text": "Meine Haut neigt zu Unreinheit"
  },
  {
   "start": 59.5,
   "end": 62.5,
   "text": "Oh mein Gott, wie seh ich aus"
  },
  {
   "start": 62.5,
   "end": 66.5,
   "text": "Heimlich steh ich vorm Spiegel"
  },
  {
   "start": 66.5,
   "end": 76.0,
   "text": "Dr\u00fcck mir einen Pickel auf"
  },
  {
   "start": 81.5,
   "end": 84.5,
   "text": "Doch dann eines Tages, da kam sie"
  },
  {
   "start": 84.5,
   "end": 88.5,
   "text": "Sie sagte: Akne, c'est la vie"
  },
  {
   "start": 88.5,
   "end": 91.5,
   "text": "Sie hat mit Pickeln kein Problem"
  },
  {
   "start": 91.5,
   "end": 95.5,
   "text": "Nicht mit Furunkeln und nicht mit Ekzem"
  },
  {
   "start": 95.5,
   "end": 98.5,
   "text": "F\u00fcr sie z\u00e4hlt nicht die \u00e4u\u00dfre H\u00e4rte"
  },
  {
   "start": 98.5,
   "end": 102.5,
   "text": "F\u00fcr sie z\u00e4hlen nur die innren Werte"
  },
  {
   "start": 102.5,
   "end": 105.5,
   "text": "Sie sagt: Sei mutig, steh dazu"
  },
  {
   "start": 105.5,
   "end": 112.5,
   "text": "Dr\u00fcck sie aus, dann hast du Ruh"
  },
  {
   "start": 113.0,
   "end": 114.5,
   "text": "Und darum:"
  },
  {
   "start": 114.5,
   "end": 117.5,
   "text": "Ich hab Akne, ich hab Akne, ich hab Akne"
  },
  {
   "start": 117.5,
   "end": 124.5,
   "text": "Meine Poren sind verschmutzt und ganz verstopft"
  },
  {
   "start": 124.5,
   "end": 128.5,
   "text": "Meine Haut neigt zu Unreinheit"
  },
  {
   "start": 128.5,
   "end": 131.5,
   "text": "Oh mon Dieu, wie seh ich aus"
  },
  {
   "start": 131.5,
   "end": 135.5,
   "text": "Heimlich steh ich vorm Spiegel"
  },
  {
   "start": 135.5,
   "end": 145.0,
   "text": "Dr\u00fcck mir einen Pickel auf"
  },
  {
   "start": 146.0,
   "end": 149.5,
   "text": "Ihr habt Akne, ihr habt Akne, ihr habt Akne"
  },
  {
   "start": 149.5,
   "end": 155.5,
   "text": "Und dazu ein kleines bisschen Mundgeruch"
  },
  {
   "start": 156.5,
   "end": 159.5,
   "text": "Ja Ger\u00fcche und Ged\u00fcfte"
  },
  {
   "start": 159.5,
   "end": 163.5,
   "text": "Die geh\u00f6ren zu einem Mann"
  },
  {
   "start": 163.5,
   "end": 167.5,
   "text": "Darum lass ich, wenn ich bei dir liege"
  },
  {
   "start": 167.5,
   "end": 170.5,
   "text": "Meine"
  },
  {
   "start": 174.5,
   "end": 181.5,
   "text": "Stiefel an"
  }
 ],
