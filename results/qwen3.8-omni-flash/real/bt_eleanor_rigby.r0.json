 "lyrics": [
  {
   "start": 0.0,
   "end": 5.65,
   "text": "Ah, look at all the lonely people"
  },
  {
   "start": 6.92,
   "end": 12.5,
   "text": "Ah, look at all the lonely people"
  },
  {
   "start": 13.82,
   "end": 20.27,
   "text": "Eleanor Rigby picks up the rice in the church where a wedding has been"
  },
  {
   "start": 20.87,
   "end": 22.47,
   "text": "Lives in a dream"
  },
  {
   "start": 22.67,
   "end": 28.75,
   "text": "Waits at the window, wearing the face that she keeps in a jar by the door"
  },
  {
   "start": 29.59,
   "end": 31.15,
   "text": "Who is it for?"
  },
  {
   "start": 31.35,
   "end": 37.71,
   "text": "All the lonely people, where do they all come from?"
  },
  {
   "start": 38.31,
   "end": 44.55,
   "text": "All the lonely people, where do they all belong?"
  },
  {
   "start": 45.27,
   "end": 51.11,
   "text": "Father McKenzie writing the words of a sermon that no one will hear"
  },
  {
   "start": 52.07,
   "end": 53.75,
   "text": "No one comes near"
  },
  {
   "start": 54.03,
   "end": 60.03,
   "text": "Look at him working, darning his socks in the night when there's nobody there"
  },
  {
   "start": 60.95,
   "end": 62.47,
   "text": "What does he care?"
  },
  {
   "start": 62.75,
   "end": 69.07,
   "text": "All the lonely people, where do they all come from?"
  },
  {
   "start": 69.67,
   "end": 75.91,
   "text": "All the lonely people, where do they all belong?"
  },
  {
   "start": 76.63,
   "end": 82.31,
   "text": "Ah, look at all the lonely people"
  },
  {
   "start": 83.55,
   "end": 89.15,
   "text": "Ah, look at all the lonely people"
  },
  {
   "start": 90.39,
   "end": 96.31,
   "text": "Eleanor Rigby died in the church and was buried along with her name"
  },
  {
   "start": 97.27,
   "end": 98.79,
   "text": "Nobody came"
  },
  {
   "start": 98.95,
   "end": 105.03,
   "text": "Father McKenzie wiping the dirt from his hands as he walks from the grave"
  },
  {
   "start": 105.91,
   "end": 107.43,
   "text": "No one was saved"
  },
  {
   "start": 107.75,
   "end": 114.07,
   "text": "All the lonely people (Ah, look at all the lonely people), where do they all come from?"
  },
