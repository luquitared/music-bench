 "lyrics": [
  {
   "start": 18,
   "end": 22,
   "text": "He's a whistler when the wind blows"
  },
  {
   "start": 22,
   "end": 27,
   "text": "Keeps it simple, only whole notes"
  },
  {
   "start": 27,
   "end": 34,
   "text": "Plays his hollow tune effortlessly"
  },
  {
   "start": 35,
   "end": 39,
   "text": "He just sits there in limbo"
  },
  {
   "start": 39,
   "end": 44,
   "text": "Doesn't listen, full of blowholes"
  },
  {
   "start": 44,
   "end": 52,
   "text": "Curtains sway, the old refrain repeats"
  },
  {
   "start": 53,
   "end": 57,
   "text": "A penny for a thought"
  },
  {
   "start": 57,
   "end": 61,
   "text": "For pounds of flesh he bought"
  },
  {
   "start": 61,
   "end": 69,
   "text": "A peso for what not to confess here"
  },
  {
   "start": 70,
   "end": 74,
   "text": "The last shall be the first"
  },
  {
   "start": 74,
   "end": 78,
   "text": "A wordless legal worst"
  },
  {
   "start": 78,
   "end": 86,
   "text": "Death is not the worst atrocity"
  },
  {
   "start": 87,
   "end": 91,
   "text": "There's a hissing through the window"
  },
  {
   "start": 91,
   "end": 95,
   "text": "Like a twisted virtuoso"
  },
  {
   "start": 95,
   "end": 103,
   "text": "Warning of a storm brewing ahead"
  },
  {
   "start": 104,
   "end": 108,
   "text": "To the victor goes the intro"
  },
  {
   "start": 108,
   "end": 112,
   "text": "Fully whispered innuendo"
  },
  {
   "start": 112,
   "end": 121,
   "text": "And time once more, a paranoid crusade"
  },
  {
   "start": 139,
   "end": 143,
   "text": "The past shall be reversed"
  },
  {
   "start": 143,
   "end": 147,
   "text": "The dead not so uncursed"
  },
  {
   "start": 147,
   "end": 155,
   "text": "A universe rehearsed in tragedy"
  },
  {
   "start": 156,
   "end": 159,
   "text": "He's a whistler, he's a widow"
  },
  {
   "start": 159,
   "end": 164,
   "text": "Doesn't miss her, plays it solo"
  },
  {
   "start": 164,
   "end": 172,
   "text": "Blissfully ignoring his estate"
  },
  {
   "start": 173,
   "end": 177,
   "text": "Tears bitter on the pillow"
  },
  {
   "start": 177,
   "end": 181,
   "text": "Makes his mission not to know 'em"
  },
  {
   "start": 181,
   "end": 190,
   "text": "Curtains flutter, the old refrain repeats"
  },
  {
   "start": 191,
   "end": 198,
   "text": "He's a whistler"
  },
  {
   "start": 207,
   "end": 211,
   "text": "He's a whistler"
  },
  {
   "start": 211,
   "end": 215,
   "text": "He's a whistler"
  },
  {
