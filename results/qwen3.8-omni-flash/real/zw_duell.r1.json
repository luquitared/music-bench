 "lyrics": [
  {
   "start": 15.89,
   "end": 22.5,
   "text": "Gn\u00e4diges Fr\u00e4ulein, ich bitte um Verzeihung"
  },
  {
   "start": 23.5,
   "end": 29.5,
   "text": "Und um einen Augenblick Geh\u00f6r."
  },
  {
   "start": 30.5,
   "end": 37.5,
   "text": "Es ist die Frage von dringlicher Bedeutung,"
  },
  {
   "start": 38.5,
   "end": 44.5,
   "text": "Und sie lastet in mir schwer."
  },
  {
   "start": 46.0,
   "end": 52.0,
   "text": "Der Zufall lenkte meine Schritte"
  },
  {
   "start": 53.5,
   "end": 58.5,
   "text": "Gestern an den Ostseestrand,"
  },
  {
   "start": 59.5,
   "end": 66.5,
   "text": "Wo ich sie dann in dessen wei\u00dfer Mitte"
  },
  {
   "start": 67.0,
   "end": 73.0,
   "text": "Mitten am anderen Manne fand."
  },
  {
   "start": 74.0,
   "end": 81.0,
   "text": "O zarte Hand, was stets selbst dir Schmuck und Zierde,"
  },
  {
   "start": 81.5,
   "end": 88.5,
   "text": "Nun erdr\u00fcckt durch des Ringes Last,"
  },
  {
   "start": 89.0,
   "end": 95.5,
   "text": "Und es gibt nichts, was ich nicht tun w\u00fcrde,"
  },
  {
   "start": 95.5,
   "end": 103.5,
   "text": "Jener Mann ist mir zutiefst verhasst."
  },
  {
   "start": 104.5,
   "end": 108.0,
   "text": "Bestellen Sie ihrem Verlobten,"
  },
  {
   "start": 108.5,
   "end": 111.5,
   "text": "Ich fordere ihn zum Duell,"
  },
  {
   "start": 112.0,
   "end": 117.0,
   "text": "Zwar schie\u00dfe ich nicht zum Vergn\u00fcgen,"
  },
  {
   "start": 118.0,
   "end": 121.0,
   "text": "Aber schnell, aber schnell, aber schnell!"
  },
  {
   "start": 141.5,
   "end": 148.5,
   "text": "Gehetzt die Wolken peitscht die Ostseewellen"
  },
  {
   "start": 149.0,
   "end": 154.5,
   "text": "Von dem Sturm, der jeden Laut zerrei\u00dft."
  },
  {
   "start": 156.0,
   "end": 163.0,
   "text": "Die graue D\u00e4mmerung allein sieht die Gesellen,"
  },
  {
   "start": 163.5,
   "end": 169.5,
   "text": "Als zwei Schatten auf des Strandes Wei\u00df."
  },
  {
   "start": 171.0,
   "end": 176.0,
   "text": "Indes durchf\u00e4hrt die Jungfrau wie ein Beben,"
  },
  {
   "start": 177.5,
   "end": 183.5,
   "text": "Wenn sie erf\u00e4hrt, wohin der Freier fuhr."
  },
  {
   "start": 184.5,
   "end": 190.5,
   "text": "Schnell, Kurt, schneller! Es geht um Tod und Leben!"
  },
  {
   "start": 191.5,
   "end": 198.5,
   "text": "Ach, und ging es doch um ihres nur!"
  },
  {
   "start": 200.0,
   "end": 203.5,
   "text": "Bestellen Sie doch ihrem Verlobten,"
  },
  {
   "start": 204.0,
   "end": 207.0,
   "text": "Die Nachricht vor der ihr graut:"
  },
  {
   "start": 207.5,
   "end": 213.0,
   "text": "Einer von beiden muss sterben,"
  },
  {
   "start": 213.5,
   "end": 217.0,
   "text": "Und sie ist des M\u00f6rders Braut."
  }
 ],
