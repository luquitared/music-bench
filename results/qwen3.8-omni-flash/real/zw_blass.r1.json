 "lyrics": [
  {
   "start": 41,
   "end": 49,
   "text": "Ich bin etwas blass, findest du nicht?"
  },
  {
   "start": 50,
   "end": 57,
   "text": "Der Fr\u00fchling ist noch immer nicht in Sicht."
  },
  {
   "start": 58,
   "end": 65,
   "text": "Ein bisschen blass und die Haut auch rau,"
  },
  {
   "start": 66,
   "end": 72,
   "text": "und kein Lied auf den Lippen, schau."
  },
  {
   "start": 74,
   "end": 81,
   "text": "Ich hab Gefallen am Herbst gefunden,"
  },
  {
   "start": 81,
   "end": 87,
   "text": "und auch an den Winter gew\u00f6hnt man sich."
  },
  {
   "start": 88,
   "end": 95,
   "text": "Ich bin ja nicht arm und krank und geschunden,"
  },
  {
   "start": 97,
   "end": 104,
   "text": "aber etwas blass findest du mich."
  },
