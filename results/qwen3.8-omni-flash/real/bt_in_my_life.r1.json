  {
   "start": 8.8,
   "end": 13.0,
   "text": "There are places I remember"
  },
  {
   "start": 13.5,
   "end": 15.9,
   "text": "All my life"
  },
  {
   "start": 16.1,
   "end": 17.9,
   "text": "Though some have changed"
  },
  {
   "start": 18.1,
   "end": 22.2,
   "text": "Some forever not for better"
  },
  {
   "start": 22.7,
   "end": 25.2,
   "text": "Some have gone"
  },
  {
   "start": 25.4,
   "end": 27.3,
   "text": "And some remain"
  },
  {
   "start": 27.5,
   "end": 31.8,
   "text": "All these places had their moments"
  },
  {
   "start": 32.4,
   "end": 34.4,
   "text": "With lovers and friends"
  },
  {
   "start": 34.7,
   "end": 36.5,
   "text": "I still can recall"
  },
  {
   "start": 36.8,
   "end": 41.0,
   "text": "Some are dead and some are living"
  },
  {
   "start": 41.7,
   "end": 43.8,
   "text": "In my life"
  },
  {
   "start": 44.0,
   "end": 48.2,
   "text": "I've loved them all"
  },
  {
   "start": 50.7,
   "end": 54.8,
   "text": "But of all these friends and lovers"
  },
  {
   "start": 55.4,
   "end": 57.8,
   "text": "There is no one"
  },
