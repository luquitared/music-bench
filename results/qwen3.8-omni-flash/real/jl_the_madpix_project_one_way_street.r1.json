 "lyrics": [
  {
   "start": 14.6,
   "end": 17.64,
   "text": "Tears are like diamonds in my eyes"
  },
  {
   "start": 18.04,
   "end": 21.0,
   "text": "Blind me so now you're out of sight"
  },
  {
   "start": 21.48,
   "end": 27.0,
   "text": "It's enough, it's too late to break this silence"
  },
  {
   "start": 28.36,
   "end": 31.4,
   "text": "In a rose colored view of us"
  },
  {
   "start": 31.76,
   "end": 34.8,
   "text": "I got lost, couldn't realize"
  },
  {
   "start": 35.2,
   "end": 38.24,
   "text": "All your lies would be blades and knives"
  },
  {
   "start": 38.84,
   "end": 40.32,
   "text": "Just stab me inside"
  },
  {
   "start": 40.72,
   "end": 44.0,
   "text": "Who will save you from this dark?"
  },
  {
   "start": 44.16,
   "end": 47.36,
   "text": "Who will fix your selfish heart?"
  },
  {
   "start": 47.44,
   "end": 50.56,
   "text": "A one way street, that's how you live"
  },
  {
   "start": 50.84,
   "end": 54.0,
   "text": "Why do you always take and never give?"
  },
  {
   "start": 83.16,
   "end": 86.12,
   "text": "Wide awake, yeah I've crossed the line"
  },
  {
   "start": 86.4,
   "end": 89.56,
   "text": "I'm coming home, I'm running back to real life"
  },
  {
   "start": 90.0,
   "end": 94.8,
   "text": "To the start where I could breathe in freely, baby"
  },
  {
   "start": 95.84,
   "end": 97.8,
   "text": "Can't you see we ran out of time"
  },
  {
   "start": 98.0,
   "end": 101.88,
   "text": "Chasing happiness while you get what you need"
  },
  {
   "start": 102.92,
   "end": 107.12,
   "text": "There's nothing left of us but bleeding blades and knives tonight"
  },
  {
   "start": 107.4,
   "end": 109.0,
   "text": "You'll know how it feels"
  },
  {
   "start": 109.2,
   "end": 112.32,
   "text": "A one way street, that's how you live"
  },
  {
   "start": 112.56,
   "end": 115.8,
   "text": "Why do you always take and never give?"
  },
  {
   "start": 116.0,
   "end": 119.2,
   "text": "I walk away to help you see"
  },
  {
   "start": 119.44,
   "end": 122.68,
   "text": "Our love is rolling down so easily"
  },
  {
   "start": 122.88,
   "end": 124.6,
   "text": "A one way street"
  },
  {
   "start": 155.2,
   "end": 157.0,
   "text": "A one way street"
  },
  {
   "start": 158.56,
   "end": 160.48,
   "text": "You never give"
  },
  {
   "start": 162.04,
   "end": 163.96,
   "text": "I walk away"
  },
  {
   "start": 165.44,
   "end": 167.6,
   "text": "So easily"
  },
  {
   "start": 167.6,
