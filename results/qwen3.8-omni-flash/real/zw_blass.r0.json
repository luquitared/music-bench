 "lyrics": [
  {
   "start": 41.0,
   "end": 44.8,
   "text": "Ich bin etwas blass"
  },
  {
   "start": 45.52,
   "end": 49.44,
   "text": "findest du nicht"
  },
  {
   "start": 50.48,
   "end": 57.2,
   "text": "Der Fr\u00fchling ist noch immer nicht in Sicht"
  },
  {
   "start": 58.68,
   "end": 62.0,
   "text": "Ein bisschen blass"
  },
  {
   "start": 62.64,
   "end": 65.32,
   "text": "und die Haut auch rau"
  },
  {
   "start": 66.76,
   "end": 70.0,
   "text": "und kein Lied auf den Lippen"
  },
  {
   "start": 70.8,
   "end": 71.64,
   "text": "schau"
  },
  {
   "start": 73.84,
   "end": 86.88,
   "text": "Ich hab Gefallen am Herbst gefunden und auch an den Winter gew\u00f6hnt man sich"
  },
  {
   "start": 87.76,
   "end": 95.04,
   "text": "Ich bin ja nicht arm und krank und geschunden"
  },
  {
   "start": 96.88,
   "end": 100.0,
   "text": "Aber etwas blass"
  },
  {
   "start": 100.88,
   "end": 104.48,
   "text": "findest du nicht"
  },
